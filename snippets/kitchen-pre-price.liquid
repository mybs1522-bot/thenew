{% if product.handle == 'kitchen-design-book' %}
<style>
  /* Sneak Peek Marquee for Kitchen Design Book */
  .kd-marquee-container {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 12px;
    width: 100%;
    padding: 10px 0 16px 0;
    position: relative;
    -webkit-mask-image: linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);
    mask-image: linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);
    margin-bottom: 24px;
  }
  .kd-marquee-group {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 12px;
    min-width: 100%;
    animation: kdScrollGroup 20s linear infinite;
    will-change: transform;
  }
  .kd-marquee-container:hover .kd-marquee-group {
    animation-play-state: paused;
  }
  @keyframes kdScrollGroup {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 12px)); }
  }
  .kd-marquee-card {
    flex: 0 0 160px;
    width: 160px;
    aspect-ratio: 1/1.3;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    box-sizing: border-box;
  }
  @media(min-width: 768px) {
    .kd-marquee-card { flex: 0 0 200px; width: 200px; }
  }
  .kd-marquee-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .kd-sneak-tag {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ea580c;
    background: #ffedd5;
    padding: 4px 12px;
    border-radius: 999px;
    margin: 0 auto 12px auto;
    display: inline-block;
  }
  
  /* High Performing Sales Pitch */
  .kd-pitch-wrapper {
    margin-bottom: 24px;
    color: #1f2937;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .kd-pitch-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 16px;
    color: #111827;
    line-height: 1.3;
  }
  .kd-pitch-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 16px;
  }
  .kd-pitch-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .kd-pitch-icon {
    flex-shrink: 0;
    margin-top: 2px;
  }
  .kd-pitch-solution {
    font-weight: 700;
    color: #ea580c;
  }
</style>

<div class="kd-pre-price-section" style="margin: 20px 0;">
  
  <div style="text-align: center;">
    <span class="kd-sneak-tag">Sneak Peek</span>
    <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0 0 16px 0; color: #111827;">Inside the Book</h3>
  </div>

  <div class="kd-marquee-container">
    <div class="kd-marquee-group">
      <div class="kd-marquee-card"><img src="{{ 'inside-kitchen-layout.png' | asset_url }}" alt="Kitchen Layout" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-countertop-height.png' | asset_url }}" alt="Countertop Height" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-fridge-placement.png' | asset_url }}" alt="Fridge Placement" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-prep-station.png' | asset_url }}" alt="Prep Station" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-kitchen-ventilation.png' | asset_url }}" alt="Kitchen Ventilation" loading="lazy"></div>
    </div>
    <div class="kd-marquee-group" aria-hidden="true">
      <div class="kd-marquee-card"><img src="{{ 'inside-kitchen-layout.png' | asset_url }}" alt="Kitchen Layout" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-countertop-height.png' | asset_url }}" alt="Countertop Height" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-fridge-placement.png' | asset_url }}" alt="Fridge Placement" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-prep-station.png' | asset_url }}" alt="Prep Station" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-kitchen-ventilation.png' | asset_url }}" alt="Kitchen Ventilation" loading="lazy"></div>
    </div>
  </div>

  <div class="kd-pitch-wrapper">
    <h4 class="kd-pitch-title">Stop guessing. Start building the perfect kitchen.</h4>
    
    <div class="kd-pitch-grid">
      <div class="kd-pitch-item">
        <span class="kd-pitch-icon">❌</span>
        <span><strong>Problem:</strong> Awkward workflows and appliances blocking pathways.<br>
        <span class="kd-pitch-solution">✅ Solution:</span> Exact clearances and golden triangle layouts.</span>
      </div>
      
      <div class="kd-pitch-item">
        <span class="kd-pitch-icon">❌</span>
        <span><strong>Problem:</strong> Wasted corner spaces and cramped storage.<br>
        <span class="kd-pitch-solution">✅ Solution:</span> Clever modular dimensions to maximize every inch.</span>
      </div>
      
      <div class="kd-pitch-item">
        <span class="kd-pitch-icon">❌</span>
        <span><strong>Problem:</strong> Expensive rework from contractor miscommunications.<br>
        <span class="kd-pitch-solution">✅ Solution:</span> Verified, hand-drawn blueprints you can hand to any carpenter.</span>
      </div>
    </div>
  </div>

</div>
{% endif %}
