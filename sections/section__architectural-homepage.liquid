    left: 5px;
  }
  .arch-section-title {
    font-size: 28px !important;
  }
  .arch-mission {
    padding: 60px 0;
  }
  .arch-spotlight {
    padding-bottom: 60px;
  }
  .arch-spotlight__card {
    padding: 28px 20px;
  }
  .arch-spotlight__pricing-row {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    width: 100%;
  }
  .arch-spotlight__separator {
    display: none;
  }
  .arch-catalog {
    padding: 60px 0;
  }
  .arch-catalog__grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  .arch-transformation {
    padding: 60px 0;
  }
  .arch-transform-box {
