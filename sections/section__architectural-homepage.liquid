<!-- AUTO-MOTION SCRIPT FOR HERO BEFORE/AFTER CARDS -->
<script>
  (function() {
    var stage = document.getElementById('hero-ba-stage');
    if (!stage) return;
    var beforeCard = stage.querySelector('.arch-ba-card-before');
    var afterCard = stage.querySelector('.arch-ba-card-after');
    var pillBefore = document.querySelector('.arch-ba-pill-before');
    var pillAfter = document.querySelector('.arch-ba-pill-after');
    if (!beforeCard || !afterCard) return;

    var current = 'before';
    var loopTimer = null;
    var isHovered = false;

    function setMode(mode) {
      current = mode;
      if (mode === 'before') {
        stage.classList.remove('is-after');
        stage.classList.add('is-before');
        beforeCard.style.zIndex = '10';
        afterCard.style.zIndex = '2';
        if (pillBefore) pillBefore.classList.add('active');
        if (pillAfter) pillAfter.classList.remove('active');
      } else {
        stage.classList.remove('is-before');
        stage.classList.add('is-after');
        afterCard.style.zIndex = '10';
        beforeCard.style.zIndex = '2';
        if (pillAfter) pillAfter.classList.add('active');
        if (pillBefore) pillBefore.classList.remove('active');
      }
    }

    function nextStep() {
      if (isHovered) return;
      setMode(current === 'before' ? 'after' : 'before');
    }

    function startLoop() {
      if (loopTimer) clearInterval(loopTimer);
      loopTimer = setInterval(nextStep, 2600);
    }

    // Initialize: Start on BEFORE first, then loop automatically
    setMode('before');
    startLoop();

    // Interaction handling
    beforeCard.addEventListener('click', function(e) {
      // allow default link or focus
      setMode('before');
      startLoop();
    });
    afterCard.addEventListener('click', function(e) {
      setMode('after');
      startLoop();
    });

    if (pillBefore) {
      pillBefore.addEventListener('click', function(e) {
        e.preventDefault();
        setMode('before');
        startLoop();
      });
    }
    if (pillAfter) {
      pillAfter.addEventListener('click', function(e) {
        e.preventDefault();
        setMode('after');
        startLoop();
      });
    }

    stage.addEventListener('mouseenter', function() { isHovered = true; });
    stage.addEventListener('mouseleave', function() { isHovered = false; });
  })();
</script>

