{% if product.handle == 'kitchen-design-book' %}
<style>
  /* Sneak Peek Marquee for Kitchen Design Book */
  .kd-marquee-container {
    display: flex;
    overflow: hidden;
    user-select: none;
    gap: 12px;
    width: 100%;
    padding: 10px 0;
    position: relative;
    -webkit-mask-image: linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);
    mask-image: linear-gradient(to right, transparent, black 24px, black calc(100% - 24px), transparent);
    margin-bottom: 16px;
  }
  .kd-marquee-group {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 12px;
    min-width: 100%;
    animation: kdScrollGroup 20s linear infinite;
    will-change: transform;
  }
  .kd-marquee-container:hover .kd-marquee-group {
    animation-play-state: paused;
  }
  @keyframes kdScrollGroup {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% - 12px)); }
  }
  .kd-marquee-card {
    flex: 0 0 160px;
    width: 160px;
    aspect-ratio: 1/1.3;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.04);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
    box-sizing: border-box;
  }
  @media(min-width: 768px) {
    .kd-marquee-card { flex: 0 0 200px; width: 200px; }
  }
  .kd-marquee-card img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }
  .kd-sneak-tag {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #ea580c;
    background: #ffedd5;
    padding: 4px 12px;
    border-radius: 999px;
    margin: 0 auto 8px auto;
    display: inline-block;
  }
  
  /* Premium FAQ Layout */
  .kd-faq-wrapper {
    margin-bottom: 16px;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 16px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }
  .kd-faq-item {
    padding-bottom: 14px;
    margin-bottom: 14px;
    border-bottom: 1px solid #f1f5f9;
  }
  .kd-faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
    margin-bottom: 0;
  }
  .kd-faq-q {
    font-size: 0.95rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 6px;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.3;
  }
  .kd-faq-q span {
    color: #ea580c;
  }
  .kd-faq-a {
    font-size: 0.85rem;
    color: #475569;
    line-height: 1.5;
    padding-left: 20px;
  }
</style>

<div class="kd-pre-price-section" style="margin-top: 0; margin-bottom: 15px;">
  
  <div style="text-align: center;">
    <span class="kd-sneak-tag">Sneak Peek</span>
    <h3 style="font-size: 1.25rem; font-weight: 800; margin: 0 0 10px 0; color: #111827;">Inside the Book</h3>
  </div>

  <div class="kd-marquee-container">
    <div class="kd-marquee-group">
      <div class="kd-marquee-card"><img src="{{ 'inside-kitchen-layout.png' | asset_url }}" alt="Kitchen Layout" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-countertop-height.png' | asset_url }}" alt="Countertop Height" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-fridge-placement.png' | asset_url }}" alt="Fridge Placement" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-prep-station.png' | asset_url }}" alt="Prep Station" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-kitchen-ventilation.png' | asset_url }}" alt="Kitchen Ventilation" loading="lazy"></div>
    </div>
    <div class="kd-marquee-group" aria-hidden="true">
      <div class="kd-marquee-card"><img src="{{ 'inside-kitchen-layout.png' | asset_url }}" alt="Kitchen Layout" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-countertop-height.png' | asset_url }}" alt="Countertop Height" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-fridge-placement.png' | asset_url }}" alt="Fridge Placement" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-prep-station.png' | asset_url }}" alt="Prep Station" loading="lazy"></div>
      <div class="kd-marquee-card"><img src="{{ 'inside-kitchen-ventilation.png' | asset_url }}" alt="Kitchen Ventilation" loading="lazy"></div>
    </div>
  </div>

  <div class="kd-faq-wrapper">
    <div class="kd-faq-item">
      <div class="kd-faq-q"><span>Q.</span> I have zero technical knowledge. Is this for me?</div>
      <div class="kd-faq-a">Absolutely. Hand-drawn, idiot-proof diagrams make standard clearances and layouts easy for anyone to understand.</div>
    </div>
    
    <div class="kd-faq-item">
      <div class="kd-faq-q"><span>Q.</span> I hired a designer. Do I still need this?</div>
      <div class="kd-faq-a">Yes. Designers charge ,000+, but this is your master-guide to cross-check their work and prevent costly mistakes.</div>
    </div>
    
    <div class="kd-faq-item">
      <div class="kd-faq-q"><span>Q.</span> How is this different from Pinterest?</div>
      <div class="kd-faq-a">Pinterest gives ideas; we give exact blueprints. Get 165+ pages of proven dimensions to hand straight to your carpenter.</div>
    </div>
  </div>

</div>
{% endif %}
