<script>
(function() {
  function onBoosterReady(theme) {
    if (theme && theme.recentlyBought) {
      setTimeout(function() {
        try {
          theme.recentlyBought.render();
        } catch(e) {}
      }, 12000);
    }
  }

  document.addEventListener('booster:loaded', function(e) {
    if (e && e.detail && e.detail.BoosterTheme) {
      window.BoosterTheme = e.detail.BoosterTheme;
      onBoosterReady(window.BoosterTheme);
    }
  });

  document.addEventListener('booster:initialized', function(e) {
    if (e && e.detail && e.detail.BoosterTheme) {
      window.BoosterTheme = e.detail.BoosterTheme;
      onBoosterReady(window.BoosterTheme);
    }
  });
})();
</script>
