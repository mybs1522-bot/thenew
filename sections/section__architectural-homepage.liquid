}

/* 5. SITE TRANSFORMATION */
.arch-transformation {
  padding: 96px 0;
  background-color: #ffffff;
}

.arch-transform-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 20px;
  padding: 56px 48px;
}

.arch-transform-header {
  text-align: center;
  max-width: 680px;
  margin: 0 auto 40px;
}

.arch-transform-title {
  font-size: 32px !important;
  font-weight: 800 !important;
  color: #09090b !important;
  letter-spacing: -0.02em;
  margin: 10px 0 14px !important;
}

.arch-transform-desc {
  font-size: 15px !important;
  color: #475569 !important;
  line-height: 1.6;
}

.arch-transform-media {
  margin-bottom: 48px;
  border-radius: 12px;
  overflow: hidden;
  box-shadow: 0 16px 36px -12px rgba(0,0,0,0.1);
  border: 1px solid #e2e8f0;
}

.arch-transform-media img {
  width: 100%;
  height: auto;
  display: block;
}

.arch-transform-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32px;
}

.arch-transform-col {
  padding: 30px;
  border-radius: 12px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
}

.arch-transform-col--bad {
  border-left: 4px solid #ef4444;
}

.arch-transform-col--good {
  border-left: 4px solid #16a34a;
}

.arch-transform-status {
  font-size: 17px !important;
  font-weight: 800 !important;
  margin: 0 0 18px !important;
  display: flex;
  align-items: center;
  gap: 8px;
}

.arch-transform-col--bad .arch-transform-status {
  color: #b91c1c !important;
}

.arch-transform-col--good .arch-transform-status {
  color: #15803d !important;
}

.arch-transform-col ul {
  list-style: none !important;
  padding: 0 !important;
  margin: 0 !important;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.arch-transform-col li {
  font-size: 14px !important;
  line-height: 1.6 !important;
  color: #334155 !important;
  position: relative;
  padding-left: 18px;
}

.arch-transform-col li::before {
  content: "•";
  position: absolute;
  left: 0;
  font-weight: bold;
}
.arch-transform-col--bad li::before { color: #ef4444; }
.arch-transform-col--good li::before { color: #16a34a; }

/* 6. TRUST & VALUE PILLARS (CLEAN LIGHT ARCHITECTURAL LUXURY) */
.arch-trust {
  padding: 48px 0;
  background-color: #f8fafc !important;
  border-top: 1px solid #e2e8f0 !important;
  border-bottom: 1px solid #e2e8f0 !important;
