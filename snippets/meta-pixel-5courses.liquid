<!-- Isolated Meta Pixel for 5 Courses Offer -->
<!-- Target Product: 5-courses-interior-exterior-design-ai (ID: 9319186694282, Variant: 50269007347850) -->
<!-- Completely suppresses sitewide pixel 2085433195424016 on this page and activates ONLY 955923376982045 -->
<script>
(function() {
  var BLOCKED_PIXEL_ID = '2085433195424016';
  var NEW_PIXEL_ID = '955923376982045';
  var TARGET_VARIANT_ID = '50269007347850';

  // --- 1. NETWORK & BEACON INTERCEPTOR (Prevents any beacon for 2085433195424016) ---
  if (window.navigator && window.navigator.sendBeacon) {
    var origSendBeacon = window.navigator.sendBeacon;
    window.navigator.sendBeacon = function(url, data) {
      if (typeof url === 'string' && url.indexOf('facebook.com/tr') !== -1 && url.indexOf(BLOCKED_PIXEL_ID) !== -1) {
        return true;
      }
      return origSendBeacon.apply(this, arguments);
    };
  }

  if (window.fetch) {
    var origFetch = window.fetch;
    window.fetch = function(input, init) {
      var url = typeof input === 'string' ? input : (input && input.url ? input.url : '');
      if (url.indexOf('facebook.com/tr') !== -1 && url.indexOf(BLOCKED_PIXEL_ID) !== -1) {
        return Promise.resolve(new Response('{}', { status: 200 }));
      }
      return origFetch.apply(this, arguments);
    };
  }

  // --- 2. FBQ METHOD INTERCEPTOR ---
  var _queue = [];
  var customFbq = function() {
    var args = Array.prototype.slice.call(arguments);

    // Block any initialization of the sitewide pixel
    if (args[0] === 'init' && String(args[1]) === BLOCKED_PIXEL_ID) {
      return;
    }

    // Block any trackSingle targeting the sitewide pixel
    if ((args[0] === 'trackSingle' || args[0] === 'trackSingleCustom') && String(args[1]) === BLOCKED_PIXEL_ID) {
      return;
    }

    // Suppress generic PageView (do not send site-wide PageView to new dataset)
    if (args[0] === 'track' && args[1] === 'PageView') {
      return;
    }
    if (args[0] === 'trackSingle' && args[2] === 'PageView') {
      return;
    }

    // Route generic track calls exclusively to the NEW pixel via trackSingle
    if (args[0] === 'track' || args[0] === 'trackCustom') {
      var eventType = args[0] === 'track' ? 'trackSingle' : 'trackSingleCustom';
      var eventName = args[1];
      var eventData = args[2] || {};
      var eventOpts = args[3] || {};

      if (customFbq.callMethod) {
        customFbq.callMethod.apply(customFbq, [eventType, NEW_PIXEL_ID, eventName, eventData, eventOpts]);
      } else {
        _queue.push([eventType, NEW_PIXEL_ID, eventName, eventData, eventOpts]);
      }
      return;
    }

    // Pass everything else to Meta's runtime
    if (customFbq.callMethod) {
      customFbq.callMethod.apply(customFbq, args);
    } else {
      _queue.push(args);
    }
  };

  customFbq.queue = _queue;
  customFbq.loaded = true;
  customFbq.version = '2.0';
  window.fbq = customFbq;
  if (!window._fbq) window._fbq = customFbq;

  // --- 3. LOAD META PIXEL RUNTIME ---
  if (!document.querySelector('script[src*="fbevents.js"]')) {
    var s = document.createElement('script');
    s.async = true;
    s.src = 'https://connect.facebook.net/en_US/fbevents.js';
    var first = document.getElementsByTagName('script')[0];
    if (first && first.parentNode) {
      first.parentNode.insertBefore(s, first);
    } else {
      document.head.appendChild(s);
    }
  }

  // --- 4. INITIALIZE ONLY THE NEW DATASET ---
  customFbq('set', 'autoConfig', false, NEW_PIXEL_ID);
  customFbq('init', NEW_PIXEL_ID);

  // --- 5. EMIT VIEWCONTENT EXCLUSIVELY ON 955923376982045 ---
  customFbq('trackSingle', NEW_PIXEL_ID, 'ViewContent', {
