{% comment %}
  5 Courses for Interior/Exterior Design + AI - High-Converting About & Landing Component
  AutoCAD, SketchUp, V-Ray, D5 Render, and AI in Interior & Architecture Design
{% endcomment %}

<div id="course-5bundle-about" class="c5b-root">
  <style>
    #course-5bundle-about {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      color: #0f172a;
      line-height: 1.6;
      padding: 10px 0 50px;
      max-width: 1100px;
      margin: 0 auto;
    }

    #course-5bundle-about * {
      box-sizing: border-box;
    }

    /* Eyebrow & Badges */
    .c5b-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #ea580c;
      background: #fff7ed;
      border: 1px solid #ffedd5;
      padding: 6px 14px;
      border-radius: 9999px;
      margin-bottom: 16px;
    }

    .c5b-hero {
      text-align: center;
      margin-bottom: 40px;
    }

    .c5b-title {
      font-size: 34px;
      font-weight: 900;
      letter-spacing: -0.02em;
      line-height: 1.2;
      color: #09090b;
      margin: 0 0 16px;
    }

    .c5b-subtitle {
      font-size: 18px;
      color: #475569;
      max-width: 780px;
      margin: 0 auto 28px;
      line-height: 1.55;
    }

    .c5b-pipeline-img-wrap {
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.15);
      border: 1px solid #e2e8f0;
      background: #0f172a;
      margin: 0 auto 36px;
    }

    .c5b-pipeline-img-wrap img {
      width: 100%;
      height: auto;
      display: block;
    }

    /* 4-Stat Pillars */
    .c5b-stats-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin-bottom: 48px;
    }

    @media (max-width: 768px) {
      .c5b-stats-grid {
        grid-template-columns: repeat(2, 1fr);
      }
      .c5b-title {
        font-size: 26px;
      }
      .c5b-subtitle {
        font-size: 15px;
      }
    }

    .c5b-stat-card {
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 16px;
      padding: 20px 16px;
      text-align: center;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .c5b-stat-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05);
      border-color: #fdba74;
    }

    .c5b-stat-num {
      font-size: 28px;
      font-weight: 900;
      color: #ea580c;
      line-height: 1;
      margin-bottom: 6px;
    }

    .c5b-stat-label {
      font-size: 13px;
      font-weight: 600;
      color: #64748b;
    }

    /* Section Headings */
    .c5b-section-hdr {
      text-align: center;
      margin-bottom: 32px;
    }

    .c5b-section-hdr h3 {
      font-size: 26px;
      font-weight: 800;
      color: #0f172a;
      margin: 8px 0 10px;
    }

    .c5b-section-hdr p {
      font-size: 15px;
      color: #64748b;
      max-width: 650px;
      margin: 0 auto;
    }

    /* Courses Accordion / Grid */
    .c5b-courses-list {
      display: flex;
      flex-direction: column;
      gap: 24px;
      margin-bottom: 50px;
    }

    .c5b-course-card {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.04);
      display: grid;
      grid-template-columns: 280px 1fr;
      transition: border-color 0.2s, box-shadow 0.2s;
    }

    .c5b-course-card:hover {
      border-color: #ea580c;
      box-shadow: 0 12px 30px rgba(234, 88, 12, 0.08);
    }

    @media (max-width: 820px) {
      .c5b-course-card {
        grid-template-columns: 1fr;
      }
    }

    .c5b-course-media {
      background: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      min-height: 220px;
      overflow: hidden;
    }

    .c5b-course-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .c5b-course-body {
      padding: 28px 32px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    @media (max-width: 640px) {
      .c5b-course-body {
        padding: 20px;
      }
    }

    .c5b-course-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .c5b-software-pill {
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      padding: 4px 10px;
      border-radius: 6px;
      letter-spacing: 0.05em;
    }

    .pill-sketchup { background: #dbeafe; color: #1d4ed8; }
    .pill-vray { background: #ede9fe; color: #6d28d9; }
    .pill-d5 { background: #fae8ff; color: #a21caf; }
    .pill-autocad { background: #fee2e2; color: #b91c1c; }
    .pill-ai { background: #ffedd5; color: #c2410c; }

    .c5b-student-count {
      font-size: 12px;
      font-weight: 700;
      color: #059669;
      background: #ecfdf5;
      padding: 3px 8px;
      border-radius: 9999px;
    }

    .c5b-course-title {
      font-size: 20px;
      font-weight: 800;
      color: #0f172a;
      margin: 0 0 10px;
    }

    .c5b-course-desc {
      font-size: 14px;
      color: #475569;
      line-height: 1.5;
      margin-bottom: 16px;
    }

    .c5b-points-list {
      list-style: none;
      padding: 0;
      margin: 0 0 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .c5b-points-list li {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      font-size: 13px;
      color: #334155;
      line-height: 1.45;
    }

    .c5b-points-list svg {
      width: 16px;
      height: 16px;
      color: #ea580c;
      flex-shrink: 0;
      margin-top: 2px;
    }

    .c5b-workflow-tag {
      font-size: 12px;
      font-weight: 700;
      color: #ea580c;
      background: #fff7ed;
      border-left: 3px solid #ea580c;
      padding: 8px 12px;
      border-radius: 0 8px 8px 0;
    }

    /* Transformation Story / Before After */
    #course-5bundle-about .c5b-transformation-box {
      background: linear-gradient(145deg, #0b1120 0%, #0f172a 100%) !important;
      border: 1px solid #1e293b !important;
      border-radius: 24px !important;
      padding: 42px 32px !important;
      color: #ffffff !important;
      margin-bottom: 50px !important;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25) !important;
      position: relative !important;
      overflow: hidden !important;
    }

    @media (max-width: 640px) {
      #course-5bundle-about .c5b-transformation-box {
        padding: 26px 18px !important;
        border-radius: 18px !important;
      }
    }

    #course-5bundle-about .c5b-trans-header {
      text-align: center !important;
      margin-bottom: 28px !important;
    }

    #course-5bundle-about .c5b-trans-heading {
      color: #ffffff !important;
      font-size: clamp(22px, 3.8vw, 30px) !important;
      font-weight: 900 !important;
      margin: 12px 0 10px 0 !important;
      line-height: 1.25 !important;
      letter-spacing: -0.02em !important;
      text-align: center !important;
    }

    #course-5bundle-about .c5b-trans-subheading {
      color: #cbd5e1 !important;
      font-size: clamp(14px, 2.2vw, 15.5px) !important;
      max-width: 650px !important;
      margin: 0 auto !important;
      line-height: 1.55 !important;
      text-align: center !important;
      font-weight: 400 !important;
    }

    #course-5bundle-about .c5b-trans-grid {
      display: grid !important;
      grid-template-columns: 1fr 1fr !important;
      gap: 22px !important;
      align-items: stretch !important;
    }

    @media (max-width: 768px) {
      #course-5bundle-about .c5b-trans-grid {
        grid-template-columns: 1fr !important;
        gap: 18px !important;
      }
    }

    #course-5bundle-about .c5b-trans-card {
      border-radius: 18px !important;
      padding: 24px 22px !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 16px !important;
      box-sizing: border-box !important;
    }

    #course-5bundle-about .c5b-trans-card-without {
      background: rgba(239, 68, 68, 0.08) !important;
      border: 1.5px solid rgba(239, 68, 68, 0.3) !important;
    }

    #course-5bundle-about .c5b-trans-card-with {
      background: rgba(16, 185, 129, 0.1) !important;
      border: 1.5px solid rgba(16, 185, 129, 0.45) !important;
      box-shadow: 0 8px 24px rgba(16, 185, 129, 0.08) !important;
    }

    #course-5bundle-about .c5b-trans-card-top {
      display: flex !important;
      flex-direction: column !important;
      gap: 8px !important;
      align-items: flex-start !important;
    }

    #course-5bundle-about .c5b-trans-badge-green {
      display: inline-block !important;
      font-size: 11.5px !important;
      font-weight: 800 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.08em !important;
      background: rgba(16, 185, 129, 0.2) !important;
      color: #34d399 !important;
      border: 1px solid rgba(16, 185, 129, 0.45) !important;
      padding: 6px 14px !important;
      border-radius: 9999px !important;
    }

    #course-5bundle-about .c5b-trans-badge-red {
      display: inline-block !important;
      font-size: 11px !important;
      font-weight: 800 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.06em !important;
      background: rgba(239, 68, 68, 0.22) !important;
      color: #fca5a5 !important;
      border: 1px solid rgba(239, 68, 68, 0.45) !important;
      padding: 5px 12px !important;
      border-radius: 9999px !important;
    }

    #course-5bundle-about .c5b-trans-badge-card-green {
      display: inline-block !important;
      font-size: 11px !important;
      font-weight: 800 !important;
      text-transform: uppercase !important;
      letter-spacing: 0.06em !important;
      background: rgba(16, 185, 129, 0.25) !important;
      color: #6ee7b7 !important;
      border: 1px solid rgba(16, 185, 129, 0.5) !important;
      padding: 5px 12px !important;
      border-radius: 9999px !important;
    }

    #course-5bundle-about .c5b-trans-card .c5b-trans-title {
      font-size: 18.5px !important;
      font-weight: 800 !important;
      color: #ffffff !important;
      margin: 0 !important;
      line-height: 1.3 !important;
      letter-spacing: -0.015em !important;
    }

    #course-5bundle-about .c5b-trans-list {
      list-style: none !important;
      padding: 0 !important;
      margin: 0 !important;
      display: flex !important;
      flex-direction: column !important;
      gap: 12px !important;
    }

    #course-5bundle-about .c5b-trans-list li {
      display: flex !important;
      align-items: flex-start !important;
      gap: 10px !important;
      font-size: 14px !important;
      line-height: 1.5 !important;
      margin: 0 !important;
      padding: 0 !important;
    }

    #course-5bundle-about .c5b-trans-list-without li {
      color: #e2e8f0 !important;
    }

    #course-5bundle-about .c5b-trans-list-without strong {
      color: #fecaca !important;
      font-weight: 700 !important;
    }

    #course-5bundle-about .c5b-trans-icon-cross {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 20px !important;
      height: 20px !important;
      background: rgba(239, 68, 68, 0.2) !important;
      border: 1px solid rgba(239, 68, 68, 0.4) !important;
      color: #f87171 !important;
      border-radius: 50% !important;
      font-size: 11px !important;
      font-weight: 900 !important;
      flex-shrink: 0 !important;
      margin-top: 2px !important;
    }

    #course-5bundle-about .c5b-trans-list-with li {
      color: #ffffff !important;
    }

    #course-5bundle-about .c5b-trans-list-with strong {
      color: #6ee7b7 !important;
      font-weight: 700 !important;
    }

    #course-5bundle-about .c5b-trans-icon-check {
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 20px !important;
      height: 20px !important;
      background: rgba(16, 185, 129, 0.25) !important;
      border: 1px solid rgba(16, 185, 129, 0.5) !important;
      color: #34d399 !important;
      border-radius: 50% !important;
      font-size: 12px !important;
      font-weight: 900 !important;
      flex-shrink: 0 !important;
      margin-top: 2px !important;
    }

    /* Renders Gallery */
    .c5b-gallery-section {
      margin-bottom: 50px;
    }

    .c5b-renders-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    @media (max-width: 768px) {
      .c5b-renders-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 480px) {
      .c5b-renders-grid {
        grid-template-columns: 1fr;
      }
    }

    .c5b-render-item {
      border-radius: 16px;
      overflow: hidden;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
      position: relative;
      aspect-ratio: 4/3;
      background: #0f172a;
    }

    .c5b-render-item img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      transition: transform 0.3s ease;
    }

    .c5b-render-item:hover img {
      transform: scale(1.05);
    }

    /* Value Stack Card */
    .c5b-value-stack {
      background: #f8fafc;
      border: 2px solid #e2e8f0;
      border-radius: 24px;
      padding: 36px;
      margin-bottom: 50px;
    }

    .c5b-stack-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 0;
      border-bottom: 1px solid #e2e8f0;
      font-size: 14px;
    }

    .c5b-stack-item:last-child {
      border-bottom: none;
    }

    .c5b-stack-name {
      font-weight: 700;
      color: #1e293b;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .c5b-stack-val {
      font-weight: 800;
      color: #ea580c;
    }

    .c5b-total-box {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 2px dashed #cbd5e1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 16px;
    }

    .c5b-total-price {
      font-size: 32px;
      font-weight: 900;
      color: #0f172a;
    }

    .c5b-total-orig {
      font-size: 18px;
      color: #94a3b8;
      text-decoration: line-through;
      margin-left: 8px;
      font-weight: 600;
    }

    .c5b-enroll-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #ea580c;
      color: #ffffff !important;
      font-weight: 800;
      font-size: 15px;
      padding: 14px 28px;
      border-radius: 12px;
      text-decoration: none;
      cursor: pointer;
      box-shadow: 0 10px 25px rgba(234, 88, 12, 0.35);
      transition: all 0.2s ease;
      border: none;
    }

    .c5b-enroll-btn:hover {
      background: #c2410c;
      transform: translateY(-2px);
      box-shadow: 0 14px 30px rgba(234, 88, 12, 0.45);
    }

    /* FAQ Accordion */
    .c5b-faq-box {
      margin-bottom: 40px;
    }

    .c5b-faq-item {
      background: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 14px;
      margin-bottom: 12px;
      overflow: hidden;
    }

    .c5b-faq-q {
      padding: 18px 20px;
      font-size: 15px;
      font-weight: 800;
      color: #1e293b;
      cursor: pointer;
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: #f8fafc;
      user-select: none;
    }

    .c5b-faq-q:hover {
      color: #ea580c;
    }

    .c5b-faq-a {
      padding: 0 20px 18px;
      font-size: 14px;
      color: #475569;
      line-height: 1.6;
      display: none;
    }

    .c5b-faq-item.active .c5b-faq-a {
      display: block;
    }

    .c5b-faq-item.active .c5b-faq-icon {
      transform: rotate(180deg);
    }

    .c5b-faq-icon {
      transition: transform 0.2s ease;
      color: #64748b;
    }
  </style>

  <!-- Hero & Pipeline Overview -->
  <div class="c5b-hero">
    <div class="c5b-badge">⚡ Master the End-to-End Architectural Pipeline</div>
    <h2 class="c5b-title">5 Masterclasses: 2D Drafting, 3D Modeling, Realism &amp; AI</h2>
    <p class="c5b-subtitle">
      Stop wasting weeks trying to connect disconnected software. Master <strong>AutoCAD</strong>, <strong>SketchUp Pro</strong>, <strong>V-Ray</strong>, <strong>D5 Render AI</strong>, and <strong>Generative AI</strong> in one seamless, professional workflow.
    </p>

    <!-- Pipeline Showcase Image -->
    <div class="c5b-pipeline-img-wrap">
      <img src="{{ 'plan-to-render-pipeline.png' | asset_url }}" alt="2D Plan to 3D Model to Photorealistic Render Pipeline" loading="lazy">
    </div>

    <!-- 4 Stats Pillars -->
    <div class="c5b-stats-grid">
      <div class="c5b-stat-card">
        <div class="c5b-stat-num">5</div>
        <div class="c5b-stat-label">Industry-Standard Courses</div>
      </div>
      <div class="c5b-stat-card">
        <div class="c5b-stat-num">10,000+</div>
        <div class="c5b-stat-label">Textures &amp; 3D Models</div>
      </div>
      <div class="c5b-stat-card">
        <div class="c5b-stat-num">24/7</div>
        <div class="c5b-stat-label">Expert Team Support</div>
      </div>
      <div class="c5b-stat-card">
        <div class="c5b-stat-num">100%</div>
        <div class="c5b-stat-label">Money-Back Guarantee</div>
      </div>
    </div>
  </div>

  <!-- The 5 Courses Curriculum -->
  <div class="c5b-section-hdr">
    <span class="c5b-badge">Curriculum Breakdown</span>
    <h3>Inside the 5 Master Courses</h3>
    <p>Every tool selected to give you an unfair advantage in freelance design, architecture studios, and client presentations.</p>
  </div>

  <div class="c5b-courses-list">
    <!-- Course 1: SketchUp Pro -->
    <div class="c5b-course-card">
      <div class="c5b-course-media">
        <img src="https://lh3.googleusercontent.com/d/1wl6by5AO5MiPeoYsZ8F6Zi5AJahoeTQo" alt="SketchUp Pro Course" loading="lazy">
      </div>
      <div class="c5b-course-body">
        <div class="c5b-course-top">
          <span class="c5b-software-pill pill-sketchup">Course 01 • SketchUp Pro</span>
          <span class="c5b-student-count">55k+ Students</span>
        </div>
        <h4 class="c5b-course-title">SketchUp Pro: 3D Spatial &amp; Interior Modeling</h4>
        <p class="c5b-desc">Build complete 3D interiors and building structures from scratch. Learn wall construction, door &amp; window framing, custom cabinetry, and precision spatial modeling.</p>
        <ul class="c5b-points-list">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Turn 2D floor plans into full 3D homes, custom kitchens &amp; master baths</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Craft custom millwork: baseboards, crown molding, wardrobes &amp; media units</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Organize models with clean tags &amp; layers ready for V-Ray and D5 export</span>
          </li>
        </ul>
        <div class="c5b-workflow-tag">Workflow Impact: Model an entire client space in hours instead of days.</div>
      </div>
    </div>

    <!-- Course 2: V-Ray Photorealism -->
    <div class="c5b-course-card">
      <div class="c5b-course-media">
        <img src="https://lh3.googleusercontent.com/d/1aHEt_z78tYD_0Cn66DiduAnhwn-o8El8" alt="V-Ray Photorealism" loading="lazy">
      </div>
      <div class="c5b-course-body">
        <div class="c5b-course-top">
          <span class="c5b-software-pill pill-vray">Course 02 • V-Ray</span>
          <span class="c5b-student-count">48k+ Students</span>
        </div>
        <h4 class="c5b-course-title">V-Ray: Studio &amp; Photorealistic Rendering</h4>
        <p class="c5b-desc">Transform raw SketchUp geometry into magazine-grade photographs. Master realistic daylighting, artificial mood lighting, reflections, and PBR textures that sell $5,000+ projects.</p>
        <ul class="c5b-points-list">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Master Sun &amp; Sky systems, HDRIs, recessed spotlights &amp; accent LED strips</span>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
            <span>Create photoreal materials: wood grain, veined marble, brushed brass &amp; sheer curtains</span>
