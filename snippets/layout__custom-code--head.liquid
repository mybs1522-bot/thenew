  font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
}
.luxury-trust-sub {
  font-size: 11px !important;
  font-weight: 400 !important;
  color: #6b7280 !important;
  line-height: 1.3 !important;
  font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
}
@media (max-width: 640px) {
