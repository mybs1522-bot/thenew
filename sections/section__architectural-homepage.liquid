  gap: 12px;
}

.arch-spotlight__features li {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  font-size: 14.5px;
  color: #334155;
  line-height: 1.5;
}

.arch-spotlight__features svg {
  flex-shrink: 0;
  margin-top: 2px;
}

.arch-spotlight__pricing-row {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
  flex-wrap: wrap;
}

.arch-spotlight__amount {
  font-size: 38px;
  font-weight: 900;
  color: #ea580c;
  line-height: 1;
}

.arch-spotlight__type {
  font-size: 14px;
  font-weight: 700;
  color: #64748b;
  margin-left: 8px;
}

.arch-strike {
  text-decoration: line-through;
  color: #94a3b8;
  margin-left: 4px;
}

.arch-spotlight__tag-pill {
  font-size: 12px;
  font-weight: 800;
  background: #f1f5f9;
  color: #475569;
  padding: 6px 14px;
  border-radius: 9999px;
  border: 1px solid #e2e8f0;
}

.arch-spotlight__image img {
  width: 100%;
  height: auto;
  border-radius: 16px;
  border: 1px solid #e2e8f0;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
}

/* 4. COURSES BREAKDOWN GRID */
.arch-courses-section {
  padding: 80px 0;
  background: #ffffff;
  border-bottom: 1px solid #f1f5f9;
}

.arch-courses-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.arch-course-card {
  background: #ffffff;
  border: 1px solid #e2e8f0;
  border-radius: 18px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.arch-course-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 35px -8px rgba(15, 23, 42, 0.12);
  border-color: #cbd5e1;
}

.arch-course-card--highlight {
  background: linear-gradient(135deg, #fff7ed 0%, #ffffff 100%);
  border: 2px solid #fed7aa;
  justify-content: center;
}

.arch-course-media {
  position: relative;
  width: 100%;
  height: 200px;
  background: #0f172a;
  overflow: hidden;
}

.arch-course-media img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.arch-course-badge {
  position: absolute;
  top: 10px;
  left: 10px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 4px 8px;
  border-radius: 6px;
  color: #ffffff;
  text-transform: uppercase;
}

.badge-cad { background: #0284c7; }
.badge-su { background: #dc2626; }
.badge-vray { background: #4f46e5; }
.badge-d5 { background: #16a34a; }
.badge-ai { background: #9333ea; }

.arch-course-body {
  padding: 22px 20px;
  display: flex;
  flex-direction: column;
  flex: 1;
}

.arch-course-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8px;
}

.arch-stars {
  color: #f59e0b;
  font-size: 13px;
  letter-spacing: 2px;
}

.arch-students {
  font-size: 12px;
  font-weight: 700;
  color: #64748b;
}

.arch-course-title {
  font-size: 17px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 10px;
  line-height: 1.35;
}

.arch-course-title a {
  color: inherit !important;
  text-decoration: none !important;
}

.arch-course-desc {
  font-size: 13.5px;
  color: #64748b;
  line-height: 1.55;
  margin: 0 0 18px;
  flex: 1;
}

.arch-course-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 14px;
  border-top: 1px solid #f1f5f9;
}

.arch-course-status {
  font-size: 12px;
  font-weight: 800;
  color: #16a34a;
}

.arch-course-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 13px;
  font-weight: 800;
  color: #ea580c !important;
  text-decoration: none !important;
  transition: transform 0.2s ease;
}

.arch-course-btn:hover {
  transform: translateX(3px);
}

/* 5. STUDENT RENDERS GALLERY */
.arch-gallery-section {
  padding: 80px 0;
  background: #f8fafc;
  border-bottom: 1px solid #f1f5f9;
}

.arch-renders-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}

.arch-render-item {
  border-radius: 14px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid #e2e8f0;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
  transition: transform 0.2s;
}

.arch-render-item:hover {
  transform: translateY(-3px);
}

.arch-render-item img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  display: block;
}

.arch-render-caption {
  padding: 10px 14px;
  font-size: 12.5px;
  font-weight: 700;
  color: #475569;
  text-align: center;
}

/* 6. COMPARISON SECTION */
.arch-transformation {
  padding: 80px 0;
  background: #ffffff;
  border-bottom: 1px solid #f1f5f9;
}

.arch-transform-box {
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 24px;
  padding: 48px;
}

.arch-transform-header {
  text-align: center;
  max-width: 720px;
  margin: 0 auto 36px;
}

.arch-transform-title {
  font-size: 30px;
  font-weight: 900;
  color: #0f172a;
  margin: 0 0 12px;
}

.arch-transform-desc {
  font-size: 15px;
  color: #64748b;
  margin: 0;
}

.arch-transform-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.arch-transform-col {
  padding: 28px;
  border-radius: 16px;
}

.arch-transform-col--bad {
  background: #ffffff;
  border: 1px solid #fecaca;
}

.arch-transform-col--good {
  background: #ffffff;
  border: 2px solid #bbf7d0;
  box-shadow: 0 10px 30px rgba(22, 163, 74, 0.08);
}

.arch-transform-status {
  font-size: 18px;
  font-weight: 900;
  margin: 0 0 18px;
  display: flex;
  align-items: center;
  gap: 8px;
}

.arch-transform-col--bad .arch-transform-status {
  color: #dc2626;
}

.arch-transform-col--good .arch-transform-status {
  color: #16a34a;
}

.arch-transform-col ul {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.arch-transform-col li {
  font-size: 14px;
  line-height: 1.5;
  color: #334155;
  position: relative;
  padding-left: 20px;
}

.arch-transform-col--bad li::before {
  content: "—";
  position: absolute;
  left: 0;
  color: #ef4444;
  font-weight: 800;
}

.arch-transform-col--good li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: #16a34a;
  font-weight: 900;
}

/* 7. TRUST SECTION */
.arch-trust {
  padding: 60px 0;
  background: #ffffff;
  border-bottom: 1px solid #f1f5f9;
}

.arch-trust__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 32px;
}

.arch-trust-item {
  display: flex;
  align-items: flex-start;
  gap: 14px;
}

.arch-trust-item__icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  background: #fff7ed;
  color: #ea580c;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.arch-trust-item__title {
  font-size: 15px;
  font-weight: 800;
  color: #0f172a;
  margin: 0 0 4px;
}

.arch-trust-item__desc {
  font-size: 13px;
  color: #64748b;
  margin: 0;
  line-height: 1.5;
}

/* 8. CLOSING CTA BANNER */
.arch-closing-cta {
  padding: 80px 0;
  background: linear-gradient(180deg, #ffffff 0%, #fff7ed 100%);
}

.arch-closing-box {
  background: #0f172a;
  border-radius: 28px;
  padding: 60px 40px;
  text-align: center;
  box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.4);
}

.arch-closing-title {
  font-size: 36px;
  font-weight: 900;
  color: #ffffff;
  margin: 0 auto 16px;
  max-width: 700px;
  line-height: 1.25;
}

.arch-closing-desc {
  font-size: 16px;
  color: #cbd5e1;
  margin: 0 auto 32px;
  max-width: 600px;
  line-height: 1.6;
}

.arch-closing-actions {
  display: flex;
  justify-content: center;
}

/* RESPONSIVE DESIGN */
@media (max-width: 1024px) {
  .arch-hero__grid {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .arch-hero__content {
    text-align: center;
  }
  .arch-badge-row,
  .arch-hero__actions,
  .arch-metrics,
  .arch-compat-pill {
    justify-content: center;
  }
  .arch-hero__lead {
    margin-left: auto;
    margin-right: auto;
  }
  .arch-spotlight__card {
    grid-template-columns: 1fr;
    padding: 32px;
  }
  .arch-pipeline-steps {
    grid-template-columns: repeat(2, 1fr);
  }
  .arch-courses-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .arch-renders-grid {
    grid-template-columns: repeat(2, 1fr);
  }
  .arch-trust__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 640px) {
  .arch-hero {
    padding: 30px 0 50px;
  }
  .arch-hero__title {
    font-size: 28px;
  }
  .arch-hero__lead {
    font-size: 15px;
  }
  .arch-btn {
    width: 100%;
  }
  .arch-metrics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .arch-metric__divider {
    display: none;
  }
  .arch-ba-stage {
    height: 270px;
    max-width: 320px;
  }
  .arch-ba-card {
    width: 142px;
    padding: 6px 6px 10px;
    border-radius: 14px;
  }
  .arch-ba-media {
    height: 170px;
    border-radius: 9px;
  }
  .arch-ba-stage.is-before .arch-ba-card-before {
    transform: rotate(-3deg) translateX(-36px) translateY(-6px) scale(1.06);
    z-index: 10;
  }
  .arch-ba-stage.is-before .arch-ba-card-after {
    transform: rotate(7deg) translateX(46px) translateY(6px) scale(0.93);
    z-index: 2;
  }
  .arch-ba-stage.is-after .arch-ba-card-after {
    transform: rotate(3deg) translateX(36px) translateY(-6px) scale(1.06);
    z-index: 10;
  }
  .arch-ba-stage.is-after .arch-ba-card-before {
    transform: rotate(-7deg) translateX(-46px) translateY(6px) scale(0.93);
    z-index: 2;
  }
  .arch-ba-badge {
    font-size: 9px;
    padding: 3px 7px;
  }
  .arch-ba-label {
    font-size: 11.5px;
    margin-top: 8px;
  }
  .arch-ba-pills-bar {
    padding: 3px 5px;
    gap: 4px;
  }
  .arch-ba-pill {
    padding: 5px 10px;
    font-size: 11px;
  }
  .arch-pipeline-steps {
    grid-template-columns: 1fr;
  }
  .arch-courses-grid {
    grid-template-columns: 1fr;
  }
  .arch-renders-grid {
    grid-template-columns: 1fr;
  }
  .arch-transform-grid {
    grid-template-columns: 1fr;
  }
  .arch-trust__grid {
    grid-template-columns: 1fr;
  }
  .arch-closing-box {
    padding: 40px 20px;
  }
  .arch-closing-title {
    font-size: 26px;
  }
}
