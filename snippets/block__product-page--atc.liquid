<div class="product__atc {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
    {% if product.available %}
        <input style="display: none;" name="id" data-bstr-variant-input="{{product.id}}" value="{{product.selected_or_first_available_variant.id}}">

        <!-- Transparent Pill Urgency Timer Just Above Buy Now Button -->
        {% assign atc_var = product.selected_or_first_available_variant %}
        {% assign atc_price_raw = atc_var.price %}
        {% assign atc_double_raw = atc_price_raw | times: 2 %}
        {% assign atc_compare = atc_double_raw | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' %}
        {% assign atc_price = atc_price_raw | money_without_trailing_zeros | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' %}

        <div class="arch-pill-timer-wrap">
          <div class="arch-pill-timer">
            <div class="arch-pill-price-group">
              <span class="arch-pill-price-cut">{{ atc_compare }}</span>
              <span class="arch-pill-price-active">{{ atc_price }}</span>
            </div>
            <span class="arch-pill-label">OFFER ENDS IN:</span>
            <div class="arch-pill-clock-wrap" aria-live="polite">
              <span class="arch-pill-clock-unit"><strong id="atcPillHours">02</strong><small>H</small></span><!--
              --><span class="arch-pill-clock-sep">:</span><!--
              --><span class="arch-pill-clock-unit"><strong id="atcPillMinutes">57</strong><small>M</small></span><!--
              --><span class="arch-pill-clock-sep">:</span><!--
              --><span class="arch-pill-clock-unit"><strong id="atcPillSeconds">24</strong><small>S</small></span>
            </div>
          </div>
        </div>

        <div class="product__atc-row">
            <input class="quantity--input__input" value="1" data-qty-input type="hidden" name="quantity">
            {% render 'add-to-cart-button', type: 'secondary', price: product.price, text: 'Buy Now', is_buy_now: true %}
        </div>
        <div class="checkout--dynamic">
            {{ form | payment_button }}
        </div>

        <!-- Risk Reversal Badge: Instant Access | 7-Day Return -->
        <div class="arch-risk-reversal">
          <span class="arch-risk-item">
            <svg class="arch-risk-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#ea580c" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
            <span>Instant Access</span>
          </span>
          <span class="arch-risk-sep">|</span>
          <span class="arch-risk-item">
            <svg class="arch-risk-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
            <span>7-Day Return</span>
          </span>
        </div>
    {% else %}
        {% render 'sold-out-button', disabled: 'disabled' %}
    {%endif%}
</div>

<style>

/* Pay in installments directly under Buy with Shop */
.product__shoppay-installments {
  white-space: nowrap !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  width: 100% !important;
  margin: 8px 0 4px 0 !important;
  text-align: center !important;
}
.product__shoppay-installments shopify-payment-terms {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  white-space: nowrap !important;
  font-size: clamp(10.5px, 3.2vw, 13px) !important;
  margin: 0 auto !important;
}
</style>

<script>
(function() {
  function forceSingleLinePaymentTerms() {
    var pts = document.querySelectorAll('shopify-payment-terms');
    pts.forEach(function(pt) {
      if (pt && pt.shadowRoot) {
        if (!pt.shadowRoot.querySelector('#single-line-shop-pay-css')) {
          var style = document.createElement('style');
          style.id = 'single-line-shop-pay-css';
          style.textContent = `
            #shopify-installments,
            #shopify-installments p {
              white-space: nowrap !important;
              display: inline-flex !important;
              align-items: center !important;
              justify-content: center !important;
              flex-wrap: nowrap !important;
              font-size: clamp(10px, 3.1vw, 13px) !important;
              letter-spacing: -0.015em !important;
              line-height: 1.2 !important;
              margin: 0 auto !important;
            }
            #shopify-installments-content {
              white-space: nowrap !important;
              flex-shrink: 0 !important;
            }
            #shopify-installments-cta {
              display: inline-flex !important;
              align-items: center !important;
              white-space: nowrap !important;
              flex-shrink: 0 !important;
              margin-left: 3px !important;
            }
            @media (max-width: 480px) {
              #shopify-installments,
              #shopify-installments p {
                font-size: 11px !important;
                letter-spacing: -0.025em !important;
              }
            }
            @media (max-width: 360px) {
              #shopify-installments,
              #shopify-installments p {
                font-size: 9.6px !important;
                letter-spacing: -0.03em !important;
              }
            }
          `;
          pt.shadowRoot.appendChild(style);
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', forceSingleLinePaymentTerms);
  } else {
    forceSingleLinePaymentTerms();
  }

  var observer = new MutationObserver(forceSingleLinePaymentTerms);
  observer.observe(document.body, { childList: true, subtree: true });

  var attempts = 0;
  var timer = setInterval(function() {
    forceSingleLinePaymentTerms();
    attempts++;
    if (attempts > 30) clearInterval(timer);
  }, 150);
})();
</script>


