<script>
(function() {
  function suppressAllCookieBanners() {
    var selectors = [
      '#bstr--notice', '.gdpr__holder', '.gdpr__notice',
      '#shopify-privacy-banner', '.shopify-privacy-banner', 'shopify-privacy-banner',
      '#shopify-customer-privacy-banner', '.shopify-customer-privacy-banner',
      '#shopify-cookie-banner', '.shopify-cookie-banner', '.shopify-cookie-consent',
      '#shopify-consent-banner', '[id*="shopify-privacy"]', '[class*="shopify-privacy"]',
      '[id*="cookie-banner"]', '[class*="cookie-banner"]', '[id*="cookie-consent"]',
      '[id*="cookieconsent"]', '[aria-label*="cookie" i]', '[data-privacy-banner]',
      '.cc-window', '.cc-banner', '#onetrust-consent-sdk', '#CybotCookiebotDialog',
      '.osano-cm-window', '.termly-cookie-banner', '.consentmo-container'
    ];
    selectors.forEach(function(sel) {
      document.querySelectorAll(sel).forEach(function(el) {
        el.style.setProperty('display', 'none', 'important');
        el.style.setProperty('visibility', 'hidden', 'important');
        el.style.setProperty('opacity', '0', 'important');
        el.style.setProperty('height', '0px', 'important');
        el.style.setProperty('pointer-events', 'none', 'important');
        try { el.remove(); } catch(e) {}
      });
    });

    // Content text matching
    document.querySelectorAll('div, section, aside, dialog, shopify-privacy-banner').forEach(function(el) {
      if (el && el.innerText && (
        el.innerText.includes('We and our partners, including Shopify, use cookies') ||
        (el.innerText.includes('Cookie consent') && el.innerText.includes('Privacy Policy'))
      )) {
        if (el !== document.body && el !== document.documentElement) {
          el.style.setProperty('display', 'none', 'important');
          el.style.setProperty('visibility', 'hidden', 'important');
          el.style.setProperty('opacity', '0', 'important');
          try { el.remove(); } catch(e) {}
        }
      }
    });

    if (window.Shopify && window.Shopify.customerPrivacy) {
      if (typeof window.Shopify.customerPrivacy.setTrackingConsent === 'function') {
        try {
          window.Shopify.customerPrivacy.setTrackingConsent({
            analytics: true,
            marketing: true,
            preferences: true,
            sale_of_data: true
          }, function() {});
        } catch(e) {}
      }
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', suppressAllCookieBanners);
  } else {
    suppressAllCookieBanners();
  }

  var bannerObserver = new MutationObserver(suppressAllCookieBanners);
  if (document.body) {
    bannerObserver.observe(document.body, { childList: true, subtree: true });
  } else {
    document.addEventListener('DOMContentLoaded', function() {
      bannerObserver.observe(document.body, { childList: true, subtree: true });
    });
  }

  var attempts = 0;
  var interval = setInterval(function() {
    suppressAllCookieBanners();
    attempts++;
    if (attempts > 30) clearInterval(interval);
  }, 150);
})();
</script>

