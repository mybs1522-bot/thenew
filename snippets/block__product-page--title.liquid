{%- if block.settings.color != "rgba(0,0,0,0)" -%}
<style>
.product__title--{{block.id}} {
    color: {{block.settings.color}};
}
</style>
{%- endif -%}
{%- if product.handle == '5-courses-interior-exterior-design-ai' -%}
<div class="product-luxury-eyebrow">
  <span class="eyebrow-pill">
    <span class="eyebrow-dot"></span>
    Bestseller in 26 Countries | 3D &amp; AI Design
  </span>
</div>
<h1 
class="h-reset product__title product__title--{{block.id}} 
font__family--{{-block.settings.fontFamily}} font__size--{{-block.settings.fontSize}} 
 {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
    <span class="product__title-prefix">5 Courses For</span>
    <span class="product__title-highlight">Interior &amp; Exterior Design + AI</span>
</h1>
{%- else -%}
<div class="product-luxury-eyebrow">
  <span class="eyebrow-pill">
    <span class="eyebrow-dot"></span>
    Bestseller in 26 Countries | Home Design
  </span>
</div>
<h1 
class="h-reset product__title product__title--{{block.id}} 
font__family--{{-block.settings.fontFamily}} font__size--{{-block.settings.fontSize}} 
 {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
  {%- if product.title contains 'Interior' and product.title contains 'Exterior' and product.title contains 'Books' -%}
    <span class="product__title-prefix">6 Books For</span>
    <span class="product__title-highlight">Interior &amp; Exterior Design</span>
  {%- elsif product.title contains 'Interior' and product.title contains 'Exterior' and product.handle contains '6-books' -%}
    <span class="product__title-prefix">6 Books For</span>
    <span class="product__title-highlight">Interior &amp; Exterior Design</span>
  {%- else -%}
    {{ product.title }}
  {%- endif -%}
</h1>
{%- endif -%}

<style>
  .product__title,
  .product-page__title,
  h1.product__title {
    white-space: normal !important;
    line-height: 1.15 !important;
    margin-bottom: 14px !important;
  }
  .product__title-prefix {
    display: block !important;
    font-size: 30px !important;
    font-weight: 700 !important;
    color: #374151 !important;
    line-height: 1.18 !important;
    letter-spacing: -0.015em !important;
    margin-bottom: 4px !important;
    white-space: nowrap !important;
  }
  .product__title-highlight {
    display: block !important;
    font-size: 42px !important;
    font-weight: 900 !important;
    color: #000000 !important;
    line-height: 1.1 !important;
    letter-spacing: -0.03em !important;
    white-space: nowrap !important;
  }
  @media (max-width: 768px) {
    .product__title,
    .product-page__title,
    h1.product__title {
      white-space: normal !important;
      line-height: 1.14 !important;
      margin-bottom: 12px !important;
      overflow: visible !important;
      text-overflow: unset !important;
    }
    .product__title-prefix {
      font-size: clamp(23px, 6.6vw, 28px) !important;
      font-weight: 700 !important;
      color: #374151 !important;
      margin-bottom: 3px !important;
      display: block !important;
      white-space: nowrap !important;
      letter-spacing: -0.02em !important;
      line-height: 1.15 !important;
    }
    .product__title-highlight {
      font-size: clamp(26px, 7.5vw, 34px) !important;
      font-weight: 900 !important;
      color: #000000 !important;
      line-height: 1.12 !important;
      letter-spacing: -0.035em !important;
      display: block !important;
      white-space: nowrap !important;
    }
  }
  {%- if product.handle == '5-courses-interior-exterior-design-ai' -%}
  .product__title-highlight {
    font-size: 38px !important;
    white-space: normal !important;
  }
  @media (max-width: 768px) {
    .product__title-highlight {
      font-size: clamp(20px, 6.2vw, 28px) !important;
      white-space: normal !important;
      word-break: break-word !important;
      line-height: 1.18 !important;
    }
  }
  {%- endif -%}
</style>