  </div>

  <!-- Header Controls -->
  <div class="bstr-rev-controls-bar">
    <div class="bstr-rev-total-label" id="bstrRevHeaderCount">Showing 1–6 of {% if product.handle == 'kitchen-design-book' %}434{% elsif product.handle == '5-courses-interior-exterior-design-ai' %}18{% else %}436{% endif %} Reviews</div>
    <div>
      <select class="bstr-rev-sort-select" onchange="bstrChangeSort(this.value)">
