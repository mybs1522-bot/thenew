{% comment %}
  Sticky Bottom "Buy Now" Bar with Evergreen Timer (7h 37m 40s)
  Timer placed above price, commanding black & bigger Buy Now button.
  Slides up smoothly when the user scrolls down to the "About" section.
{% endcomment %}

<div id="arch-sticky-buy-bar" class="arch-sticky-bar" aria-hidden="true">
  <div class="arch-sticky-bar__inner">
    
    <!-- Left: Evergreen Urgency Timer (ABOVE) & Pricing (BELOW) -->
    <div class="arch-sticky-bar__info">
      
      <!-- Evergreen Countdown Timer (Placed ABOVE Price) -->
      <div class="arch-sticky-timer">
        <span class="arch-timer-pulse-dot"></span>
        <span class="arch-timer-label">Offer ends in:</span>
        <div class="arch-timer-display">
          <span class="arch-timer-box" id="archStickyHours">07</span><span class="arch-timer-sep">:</span><!--
          --><span class="arch-timer-box" id="archStickyMinutes">37</span><span class="arch-timer-sep">:</span><!--
          --><span class="arch-timer-box" id="archStickySeconds">40</span>
        </div>
      </div>

      <!-- Pricing Line: Crossed out Compare Price first, then Sale Price slightly bigger -->
      <div class="arch-sticky-bar__meta">
        <div class="arch-sticky-bar__pricing">
          {% assign sticky_curr_var = product.selected_or_first_available_variant %}
          {% assign sticky_double_price = sticky_curr_var.price | times: 2 %}
          <span class="arch-sticky-bar__compare" id="archStickyCompare">
            {{ sticky_double_price | money | replace: 'Rs. ', 'â‚¹' | replace: 'Rs.', 'â‚¹' | replace: 'Rs ', 'â‚¹' }}
          </span>
          <span class="arch-sticky-bar__price" id="archStickyPrice">
            {{ sticky_curr_var.price | money | replace: 'Rs. ', 'â‚¹' | replace: 'Rs.', 'â‚¹' | replace: 'Rs ', 'â‚¹' }}
          </span>
        </div>
      </div>

    </div>

    <!-- Right: Bigger, Premium Black Buy Now Action Button -->
    <div class="arch-sticky-bar__action">
      <button type="button" id="archStickyBuyBtn" class="arch-sticky-btn" onclick="executeStickyBuyNow(this)">
        <svg class="arch-sticky-btn__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="arch-sticky-btn__text">Buy Now</span>
        <svg class="arch-sticky-btn__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>

  </div>
</div>

<style>
/* â”€â”€â”€ STICKY BOTTOM BUY NOW BAR STYLING â”€â”€â”€ */
.arch-sticky-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 99999;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-top: 1px solid #e2e8f0;
  box-shadow: 0 -8px 25px rgba(0, 0, 0, 0.08), 0 -1px 3px rgba(0, 0, 0, 0.04);
  transform: translateY(115%);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  box-sizing: border-box;
}

.arch-sticky-bar.arch-sticky-bar--visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

.arch-sticky-bar__inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 12px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-sizing: border-box;
}

/* Info Section (Stacked: Timer ABOVE Price) */
.arch-sticky-bar__info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 5px;
  flex: 1;
  min-width: 0;
}

/* Evergreen Countdown Timer (Placed ABOVE Price) */
.arch-sticky-timer {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  background: #fff7ed;
  border: 1px solid #fed7aa;
  padding: 4px 11px;
  border-radius: 9999px;
  box-shadow: 0 1px 3px rgba(234, 88, 12, 0.08);
  flex-shrink: 0;
}

.arch-timer-pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #ea580c;
  display: inline-block;
  animation: archTimerPulse 1.6s infinite ease-in-out;
  flex-shrink: 0;
}

@keyframes archTimerPulse {
  0% {
    transform: scale(0.9);
    box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.7);
  }
  70% {
    transform: scale(1.15);
    box-shadow: 0 0 0 6px rgba(234, 88, 12, 0);
  }
  100% {
    transform: scale(0.9);
    box-shadow: 0 0 0 0 rgba(234, 88, 12, 0);
  }
}

.arch-timer-label {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #9a3412;
}

.arch-timer-display {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-family: 'Space Grotesk', -apple-system, monospace;
  font-size: 12px;
  font-weight: 800;
  color: #ea580c;
  letter-spacing: -0.01em;
}

.arch-timer-box {
  display: inline-block;
  min-width: 16px;
  text-align: center;
}

.arch-timer-sep {
  opacity: 0.6;
  margin: 0 -1px;
}

/* Pricing Line (Underneath Timer) */
.arch-sticky-bar__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.arch-sticky-bar__pricing {
  display: flex;
  align-items: baseline;
  gap: 8px;
  line-height: 1;
}

.arch-sticky-bar__compare {
  font-family: 'Space Grotesk', -apple-system, sans-serif;
  font-size: 15px;
  font-weight: 600;
  color: #94a3b8;
  text-decoration: line-through;
  line-height: 1;
}

.arch-sticky-bar__price {
  font-family: 'Space Grotesk', -apple-system, sans-serif;
  font-size: 21px;
  font-weight: 800;
  color: #ea580c;
  letter-spacing: -0.01em;
  line-height: 1;
}

/* Action Button: BLACK & BIGGER */
.arch-sticky-bar__action {
  flex-shrink: 0;
}

.arch-sticky-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  background: #09090b !important;
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
  font-family: 'Space Grotesk', -apple-system, sans-serif;
  font-size: 16.5px;
  font-weight: 800;
  letter-spacing: 0.02em;
  padding: 13px 32px;
  min-height: 50px;
  border-radius: 9999px;
  border: 1px solid #18181b;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.28), 0 2px 4px rgba(0, 0, 0, 0.12);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  text-decoration: none;
  white-space: nowrap;
}

.arch-sticky-btn:hover {
  transform: translateY(-1px) scale(1.02);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.42);
  background: #18181b !important;
}

.arch-sticky-btn:active {
  transform: translateY(0) scale(0.98);
  background: #000000 !important;
}

.arch-sticky-btn__icon {
  flex-shrink: 0;
  stroke: #ffffff;
}

.arch-sticky-btn__arrow {
  flex-shrink: 0;
  stroke: #ffffff;
  transition: transform 0.2s ease;
}

.arch-sticky-btn:hover .arch-sticky-btn__arrow {
  transform: translateX(3px);
}

/* Spinner for click state */
.arch-spinner {
  animation: archSpin 0.75s linear infinite;
  stroke: #ffffff;
}
@keyframes archSpin {
  100% { transform: rotate(360deg); }
}

/* â”€â”€â”€ MOBILE RESPONSIVE TWEAKS â”€â”€â”€ */
@media (max-width: 640px) {
  .arch-sticky-bar__inner {
    padding: 10px 14px;
    gap: 12px;
    align-items: center;
  }
  .arch-sticky-bar__info {
    gap: 4px;
    min-width: 0;
  }
  .arch-sticky-timer {
    padding: 3px 9px;
    gap: 5px;
  }
  .arch-timer-label {
    font-size: 8.5px;
  }
  .arch-timer-display {
    font-size: 11px;
  }
  .arch-sticky-bar__pricing {
    gap: 8px;
    align-items: baseline;
  }
  .arch-sticky-bar__compare {
    font-size: 16px;
    font-weight: 600;
    color: #94a3b8;
    text-decoration: line-through;
  }
  .arch-sticky-bar__price {
    font-size: 24px !important;
    font-weight: 900 !important;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .arch-sticky-bar__action {
    flex: 0 0 auto;
    min-width: 160px;
  }
  .arch-sticky-btn {
    width: 100%;
    min-width: 160px;
    padding: 13px 26px;
    font-size: 16px;
    font-weight: 800;
    min-height: 48px;
    gap: 8px;
    letter-spacing: 0.01em;
  }
  .arch-sticky-btn__icon {
    width: 18px;
    height: 18px;
  }
  .arch-sticky-btn__arrow {
    display: inline-block;
    width: 15px;
    height: 15px;
  }
}
</style>

<script>
(function() {
  /* 1. EVERGREEN COUNTDOWN TIMER (7 Hours 37 Min 40 Sec) */
  const DURATION_SECONDS = 7 * 3600 + 37 * 60 + 40; // 27,460 seconds
  const STORAGE_KEY = 'arch_evergreen_deadline_v1';

  function getDeadline() {
    let stored = localStorage.getItem(STORAGE_KEY);
    const now = Date.now();
    if (!stored || isNaN(parseInt(stored, 10)) || parseInt(stored, 10) <= now) {
      const newDeadline = now + DURATION_SECONDS * 1000;
      localStorage.setItem(STORAGE_KEY, newDeadline);
      return newDeadline;
    }
    return parseInt(stored, 10);
  }

  let deadline = getDeadline();

  function updateTimer() {
    const now = Date.now();
    let diff = Math.max(0, Math.floor((deadline - now) / 1000));

    if (diff <= 0) {
      // Evergreen reset once expired
      deadline = now + DURATION_SECONDS * 1000;
      localStorage.setItem(STORAGE_KEY, deadline);
      diff = DURATION_SECONDS;
    }

    const h = Math.floor(diff / 3600);
    const m = Math.floor((diff % 3600) / 60);
    const s = diff % 60;

    const elH = document.getElementById('archStickyHours');
    const elM = document.getElementById('archStickyMinutes');
    const elS = document.getElementById('archStickySeconds');
    const atcH = document.getElementById('mainAtcHours');
    const atcM = document.getElementById('mainAtcMinutes');
    const atcS = document.getElementById('mainAtcSeconds');

    const pad = n => (n < 10 ? '0' + n : '' + n);
    const hStr = pad(h);
    const mStr = pad(m);
    const sStr = pad(s);

    if (elH) elH.textContent = hStr;
    if (elM) elM.textContent = mStr;
    if (elS) elS.textContent = sStr;
    if (atcH) atcH.textContent = hStr;
    if (atcM) atcM.textContent = mStr;
    if (atcS) atcS.textContent = sStr;
  }

  setInterval(updateTimer, 1000);
  updateTimer();

  /* 2. SCROLL DETECTION: SHOW WHEN USER REACHES ABOUT SECTION */
  function getAboutSection() {
    return document.querySelector('.kd-about-section') ||
             document.getElementById('product-tabs-section') ||
           document.querySelector('.tab__container--product') ||
           document.querySelector('.book-about-editorial') ||
           document.querySelector('.lp6-hero') ||
           document.getElementById('tab--tab_synopsis') ||
           document.querySelector('.product--tab__content') ||
           document.querySelector('.product-description-avada');
  }

  function handleScrollVisibility() {
    const bar = document.getElementById('arch-sticky-buy-bar');
    if (!bar) return;

    const aboutEl = getAboutSection();
    if (!aboutEl) return;

    const rect = aboutEl.getBoundingClientRect();
    // Show when top of About section enters upper 75% of viewport
    const triggerOffset = window.innerHeight * 0.75;

    if (rect.top <= triggerOffset) {
      bar.classList.add('arch-sticky-bar--visible');
      bar.setAttribute('aria-hidden', 'false');
      document.body.classList.add('has-arch-sticky-bar');
    } else {
      bar.classList.remove('arch-sticky-bar--visible');
      bar.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('has-arch-sticky-bar');
    }
  }

  window.addEventListener('scroll', handleScrollVisibility, { passive: true });
  window.addEventListener('resize', handleScrollVisibility, { passive: true });
  document.addEventListener('DOMContentLoaded', handleScrollVisibility);
  setTimeout(handleScrollVisibility, 500);

  /* 3. SYNC PRICE WITH SWATCH / VARIANT CHANGES */
  document.addEventListener('change', function(e) {
    if (e.target && (e.target.matches('[data-swatch-index]') || e.target.name === 'id')) {
      syncPrice();
    }
  });

  function syncPrice() {
    setTimeout(function() {
      const mainPrice = document.querySelector('.product__price .price--regular') ||
                        document.querySelector('.product__price') ||
                        document.querySelector('.product-page__price');
      let text = '';
      if (mainPrice) {
        text = mainPrice.innerText.trim().split('\n')[0].replace(/Rs\.?\s*/g, 'â‚¹');
        const stickyPrice = document.getElementById('archStickyPrice');
        if (stickyPrice && text) stickyPrice.textContent = text;
      }
      
      const stickyCompare = document.getElementById('archStickyCompare');
      if (stickyCompare && text) {
        const match = text.match(/[\d,.]+/);
        if (match) {
          const rawNum = parseFloat(match[0].replace(/,/g, ''));
          if (!isNaN(rawNum) && rawNum > 0) {
            const doubled = rawNum * 2;
            const fmt = (doubled % 1 === 0) ? Math.round(doubled).toString() : doubled.toFixed(2);
            stickyCompare.textContent = text.replace(match[0], fmt);
            stickyCompare.style.display = 'inline-block';
          }
        }
      }
    }, 120);
  }

  /* 4. EXECUTE BUY NOW ACTION (Direct 1-Click to Checkout) */
  window.executeStickyBuyNow = function(btn) {
    if (!btn) btn = document.getElementById('archStickyBuyBtn');
    if (btn) {
      btn.style.opacity = '0.85';
      btn.style.pointerEvents = 'none';
      const textSpan = btn.querySelector('.arch-sticky-btn__text');
      if (textSpan) textSpan.textContent = 'Redirecting...';
    }

    // Get current active variant ID
    let variantId = null;
    const variantInput = document.querySelector('[data-bstr-variant-input]') ||
                         document.querySelector('input[name="id"]');
    if (variantInput && variantInput.value) {
      variantId = variantInput.value;
    } else {
      variantId = '{{ product.selected_or_first_available_variant.id }}';
    }

    // Direct checkout payload
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: variantId, quantity: 1 })
    })
    .then(function() {
      window.location.href = '/checkout';
    })
    .catch(function() {
      // Fallback
      const mainForm = document.querySelector('form[action*="/cart/add"]');
      if (mainForm) {
        mainForm.submit();
      } else {
        window.location.href = '/cart/' + variantId + ':1';
      }
    });
  };

})();
</script>

