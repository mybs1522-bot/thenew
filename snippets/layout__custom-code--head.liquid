<!-- Google Fonts matching kitchenind -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
/* Theme colors matching kitchenind landing page */
body {
  font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
  background-color: #fefcf9 !important;
  color: #111827 !important;
}

/* Headings */
h1, h2, h3, h4,
.product__title,
.product-page__title,
.font-display {
  font-family: 'Space Grotesk', sans-serif !important;
  letter-spacing: -0.025em;
  color: #09090b !important;
}

/* Breadcrumbs Hidden */
.breadcrumbs__wrapper,
.breadcrumbs--default,
nav.breadcrumb {
  display: none !important;
}

.product__row {
  max-width: 1160px !important;
  margin: 30px auto 40px auto !important;
  padding: 35px 30px !important;
  background: #ffffff !important;
  border: 1px solid #e5e7eb !important;
  border-radius: 20px !important;
  box-shadow: 0 4px 25px rgba(0, 0, 0, 0.04) !important;
}

@media (min-width: 769px) {
  .product__title,
  .product-page__title {
    font-size: clamp(2rem, 3.5vw, 2.7rem) !important;
    font-weight: 800 !important;
    line-height: 1.12 !important;
    margin-bottom: 10px !important;
  }
}

@media (max-width: 768px) {
  .product__title,
  .product-page__title,
  h1.product__title {
    font-size: clamp(14px, 4.25vw, 17.5px) !important;
    white-space: nowrap !important;
    letter-spacing: -0.025em !important;
    line-height: 1.25 !important;
    display: block !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    margin-bottom: 6px !important;
  }
}

/* Primary Button (Add to Cart / Buy Box) */
.button--primary,
.button--primary__default,
.sticky--atc__button {
  background: #09090b !important;
  color: #ffffff !important;
  border-radius: 14px !important;
  font-weight: 700 !important;
  transition: all 0.2s ease !important;
}

.button--primary:hover,
.sticky--atc__button:hover {
  background: #ea580c !important;
  transform: translateY(-1px) !important;
}

/* Rating Stars - Enforce single line across desktop & mobile */
.book-editorial-rating-wrapper {
  display: inline-flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: center !important;
  gap: 7px !important;
  margin: 6px 0 16px 0 !important;
  cursor: pointer !important;
  user-select: none !important;
  white-space: nowrap !important;
  max-width: 100% !important;
}
.rating-stars-gold, .star-gold {
  display: inline-flex !important;
  align-items: center !important;
  color: #f59e0b !important;
  font-size: 15px !important;
  letter-spacing: 1.5px !important;
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}
.rating-score-bold {
  font-weight: 800 !important;
  color: #09090b !important;
  font-size: 14.5px !important;
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}
.rating-count-text {
  color: #4b5563 !important;
  font-size: 13px !important;
  text-decoration: underline !important;
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}
.rating-count-text:hover {
  color: #ea580c !important;
}
.rating-dot-separator {
  color: #6b7280 !important;
  font-size: 12px !important;
  flex-shrink: 0 !important;
  white-space: nowrap !important;
  margin: 0 1px !important;
}
.rating-bestseller-badge {
  font-size: 11px !important;
  font-weight: 700 !important;
  color: #ea580c !important;
  background: #ffedd5 !important;
  padding: 3px 9px !important;
  border-radius: 12px !important;
  letter-spacing: 0.04em !important;
  text-transform: uppercase !important;
  flex-shrink: 0 !important;
  white-space: nowrap !important;
}

@media (max-width: 480px) {
  .product__row {
    padding: 20px 14px !important;
    margin: 10px auto 20px auto !important;
  }
  .book-editorial-rating-wrapper {
    gap: 5px !important;
    white-space: nowrap !important;
    flex-wrap: nowrap !important;
  }
  .rating-stars-gold, .star-gold {
    font-size: 13px !important;
    letter-spacing: 1px !important;
  }
  .rating-score-bold {
    font-size: 13.5px !important;
  }
  .rating-count-text {
    font-size: 12px !important;
  }
  .rating-bestseller-badge {
    font-size: 9.5px !important;
    padding: 2px 7px !important;
  }
}

/* Format & Edition Cards */
.default-edition-pill {
  margin: 16px 0 !important;
}
.swatches__title {
  font-size: 11px !important;
  text-transform: uppercase !important;
  letter-spacing: 0.1em !important;
  font-weight: 700 !important;
  color: #6b7280 !important;
  margin-bottom: 8px !important;
}
.default-edition-card {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  padding: 10px 18px;
  background: #fff7ed !important;
  border: 2px solid #ea580c !important;
  border-radius: 14px !important;
  cursor: pointer;
}
.edition-name {
  font-size: 13px;
  font-weight: 700;
  color: #09090b;
}
.edition-price {
  font-size: 14px;
  font-weight: 800;
  color: #ea580c;
}
.edition-badge {
  font-size: 10px;
  background: #ffedd5;
  color: #ea580c;
  padding: 2px 8px;
  border-radius: 10px;
  font-weight: 700;
}

/* Tabs: Full width modern container */
.tab__container--product,
.tab__container--product.max-width {
  max-width: 100% !important;
  width: 100% !important;
  margin: 0 auto 50px auto !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 0 !important;
  box-shadow: none !important;
}
.tab__holder {
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
  gap: 32px !important;
  border-bottom: 2px solid #f3f4f6 !important;
  margin: 0 auto 30px auto !important;
  padding: 0 16px !important;
  max-width: 1200px !important;
}
.tab--product {
  padding: 12px 18px 14px 18px !important;
  font-size: 16px !important;
  font-weight: 700 !important;
  color: #6b7280 !important;
  border-bottom: 3px solid transparent !important;
  background: transparent !important;
  border-radius: 0 !important;
  cursor: pointer !important;
  transition: all 0.2s ease !important;
}
.tab--product:hover {
  color: #ea580c !important;
}
.tab--product.tab--active {
  color: #ea580c !important;
  border-bottom: 3px solid #ea580c !important;
  background: transparent !important;
}
@media (max-width: 768px) {
  .tab__holder {
    gap: 16px !important;
    margin-bottom: 20px !important;
  }
  .tab--product {
    font-size: 15px !important;
    padding: 10px 12px 12px 12px !important;
  }
}

/* Reviews Summary */
.reviews-summary-card {
  display: flex;
  flex-wrap: wrap;
  gap: 30px;
  align-items: center;
  background: #fefcf9;
  border: 1px solid #fed7aa;
  border-radius: 16px;
  padding: 24px;
  margin-bottom: 30px;
}
.big-score {
  font-size: 44px;
  font-weight: 900;
  color: #09090b;
  line-height: 1;
  font-family: 'Space Grotesk', sans-serif;
}
.stars-gold-big {
  color: #f59e0b;
  font-size: 20px;
  margin: 6px 0;
  letter-spacing: 3px;
}
.bar-fill {
  background: #ea580c;
}
.reviewer-avatar {
  background: #ea580c;
}
.verified-pill {
  color: #ea580c;
  background: #ffedd5;
}

/* ========================================================
   ULTRA-PREMIUM PRODUCT STYLES
   ======================================================== */

/* 1. Architectural Eyebrow Pill */
.product-luxury-eyebrow {
  margin-bottom: 12px;
}
.eyebrow-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: #f4f4f5;
  color: #27272a;
  border: 1px solid #e4e4e7;
  font-size: 11.5px;
  font-weight: 700;
  letter-spacing: 0.02em;
  padding: 5px 14px;
  border-radius: 9999px;
  text-transform: none;
}
.eyebrow-dot {
  width: 6px;
  height: 6px;
  background: #ea580c;
  border-radius: 50%;
  display: inline-block;
  box-shadow: 0 0 8px rgba(234, 88, 12, 0.7);
  animation: pulse-dot 2s infinite ease-in-out;
}
@keyframes pulse-dot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.35; transform: scale(0.85); }
}

/* 2. Luxury Price & Savings Pill */
.product__price--holder {
  display: flex !important;
  align-items: center !important;
  gap: 12px !important;
  margin: 12px 0 18px 0 !important;
  flex-wrap: wrap !important;
}
.product__price {
  font-size: 2.1rem !important;
  font-weight: 900 !important;
  color: #09090b !important;
  font-family: 'Space Grotesk', sans-serif !important;
  letter-spacing: -0.03em !important;
  line-height: 1 !important;
}
.product__price--old {
  font-size: 1.25rem !important;
  color: #9ca3af !important;
  text-decoration: line-through !important;
  font-weight: 500 !important;
  margin-left: 2px !important;
}
.tag.tag--sale {
  display: inline-flex !important;
  align-items: center !important;
  background: #ecfdf5 !important;
  color: #059669 !important;
  border: 1px solid #a7f3d0 !important;
  font-size: 11px !important;
  font-weight: 800 !important;
  letter-spacing: 0.05em !important;
  padding: 4px 10px !important;
  border-radius: 9999px !important;
  text-transform: uppercase !important;
  box-shadow: 0 2px 6px rgba(16, 185, 129, 0.08) !important;
}

/* Shop Pay Installments - Force single line across all screens & mobile */
.product__shoppay-installments {
  white-space: nowrap !important;
  max-width: 100% !important;
  margin: 4px 0 14px 0 !important;
  overflow: visible !important;
}
shopify-payment-terms {
  display: block !important;
  white-space: nowrap !important;
  font-size: clamp(10px, 3.1vw, 13px) !important;
  letter-spacing: -0.015em !important;
  max-width: 100% !important;
}
@media (max-width: 480px) {
  shopify-payment-terms {
    font-size: 11px !important;
    letter-spacing: -0.025em !important;
  }
}
@media (max-width: 360px) {
  shopify-payment-terms {
    font-size: 9.6px !important;
    letter-spacing: -0.03em !important;
  }
}

/* 3. Luxury Swatches (Cards) */
.luxury-swatches-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 16px 0 20px 0;
  width: 100%;
}
.luxury-swatch-card {
  position: relative;
  background: #ffffff;
  border: 2px solid #e5e7eb;
  border-radius: 14px;
  padding: 14px 18px;
  cursor: pointer;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  user-select: none;
}
.luxury-swatch-card:hover {
  border-color: #fdba74;
  background: #fffdfa;
  transform: translateY(-1px);
  box-shadow: 0 6px 16px rgba(234, 88, 12, 0.06);
}
.luxury-swatch-card.swatch--active {
  border-color: #ea580c !important;
  background: #fffbf7 !important;
  box-shadow: 0 0 0 3px rgba(234, 88, 12, 0.15), 0 8px 20px rgba(234, 88, 12, 0.08) !important;
}
.luxury-card-badge {
  position: absolute;
  top: -10px;
  right: 16px;
  background: linear-gradient(135deg, #ea580c, #c2410c);
  color: #ffffff;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 3px 10px;
  border-radius: 9999px;
  box-shadow: 0 2px 8px rgba(234, 88, 12, 0.35);
  text-transform: uppercase;
}
.luxury-card-badge.sold-out {
  background: #64748b !important;
  box-shadow: 0 2px 6px rgba(100, 116, 139, 0.25) !important;
}
.luxury-soldout-tag {
  font-size: 10px;
  font-weight: 700;
  color: #dc2626;
  background: #fee2e2;
  padding: 2px 7px;
  border-radius: 4px;
  margin-left: 6px;
  display: inline-block;
  letter-spacing: 0.02em;
  vertical-align: middle;
}
.luxury-swatch-card[data-swatch-soldout="true"] {
  background: #fcfcfd;
  border-color: #e5e7eb;
}
.luxury-swatch-card[data-swatch-soldout="true"]:hover {
  border-color: #cbd5e1;
  background: #f8fafc;
  transform: none;
  box-shadow: none;
}
.luxury-card-inner {
  display: flex;
  align-items: center;
  gap: 14px;
  pointer-events: none;
}
.luxury-card-radio {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  border: 2px solid #d1d5db;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.2s ease;
  background: #ffffff;
}
.luxury-swatch-card.swatch--active .luxury-card-radio {
  border-color: #ea580c;
  background: #ea580c;
}
.radio-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #ffffff;
  opacity: 0;
  transform: scale(0.5);
  transition: all 0.2s ease;
}
.luxury-swatch-card.swatch--active .radio-dot {
  opacity: 1;
  transform: scale(1);
}
.luxury-card-content {
  flex-grow: 1;
}
.luxury-card-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 2px;
}
.luxury-card-title {
  font-size: 15px;
  font-weight: 800;
  color: #09090b;
  font-family: 'Space Grotesk', sans-serif;
  letter-spacing: -0.01em;
}
.luxury-card-price {
  font-size: 16px;
  font-weight: 800;
  color: #ea580c;
  font-family: 'Space Grotesk', sans-serif;
}
.luxury-card-subtitle {
  display: block;
  font-size: 12.5px;
  color: #6b7280;
  font-weight: 500;
  line-height: 1.3;
}

/* 4. Quantity and Add to Cart Button (Enforce single line on phone & desktop) */
.product__atc {
  display: flex !important;
  flex-direction: column !important;
  gap: 10px !important;
  margin: 20px 0 16px 0 !important;
  width: 100% !important;
}
.product__atc-row {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  align-items: stretch !important;
  gap: 12px !important;
  width: 100% !important;
  margin: 0 !important;
  padding: 0 !important;
}
.quantity--input {
  display: inline-flex !important;
  align-items: center !important;
  justify-content: space-between !important;
  flex: 0 0 auto !important;
  width: auto !important;
  min-width: 110px !important;
  max-width: 125px !important;
  height: 52px !important;
  min-height: 52px !important;
  max-height: 52px !important;
  margin: 0 !important;
  box-sizing: border-box !important;
  background: #f4f4f5 !important;
  border: 1px solid #e4e4e7 !important;
  border-radius: 12px !important;
  padding: 0 4px !important;
  vertical-align: middle !important;
}
.quantity--input__button {
  width: 32px !important;
  height: 100% !important;
  font-size: 18px !important;
  font-weight: 700 !important;
  color: #52525b !important;
  background: transparent !important;
  border: none !important;
  cursor: pointer !important;
  border-radius: 8px !important;
  transition: background 0.15s ease !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
}
.quantity--input__button:hover {
  background: #e4e4e7 !important;
  color: #09090b !important;
}
.quantity--input__input {
  width: 36px !important;
  height: 100% !important;
  border: none !important;
  background: transparent !important;
  text-align: center !important;
  font-weight: 800 !important;
  font-size: 16px !important;
  color: #09090b !important;
  margin: 0 !important;
  padding: 0 !important;
  line-height: 1 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}
.product__atc .button--addToCart,
.product__atc .button--primary,
.product__atc .button--secondary,
.product__atc button[data-buy-button] {
  flex: 1 1 auto !important;
  min-width: 0 !important;
  width: auto !important;
  height: 52px !important;
  min-height: 52px !important;
  max-height: 52px !important;
  margin: 0 !important;
  box-sizing: border-box !important;
  font-size: 15px !important;
  letter-spacing: 0.02em !important;
  display: inline-flex !important;
  align-items: center !important;
  justify-content: center !important;
  gap: 8px !important;
  border-radius: 12px !important;
  box-shadow: 0 4px 14px rgba(9, 9, 11, 0.12) !important;
  white-space: nowrap !important;
  padding: 0 16px !important;
  line-height: 1 !important;
  vertical-align: middle !important;
}
.atc-button-icon {
  display: inline-block !important;
  vertical-align: middle !important;
  flex-shrink: 0 !important;
  margin: 0 !important;
  color: currentColor !important;
}
.product__atc button[data-buy-button] span[data-button-text] {
  display: inline-block !important;
  line-height: 1 !important;
  margin: 0 !important;
}
.product__atc .checkout--dynamic {
  width: 100% !important;
  flex: 0 0 100% !important;
  margin-top: 2px !important;
}
.product__atc .checkout--dynamic > div,
.product__atc .checkout--dynamic iframe,
.product__atc .shopify-payment-button,
.product__atc .shopify-payment-button__button {
  width: 100% !important;
  border-radius: 12px !important;
}

/* Hide dynamic checkout button and installments completely */
.checkout--dynamic,
[data-dynamic-button],
.shopify-payment-button,
.shopify-payment-button__button,
shopify-accelerated-checkout,
.product__shoppay-installments,
.hide-non-dollar-btn,
body.non-dollar-currency .checkout--dynamic,
body.non-dollar-currency [data-dynamic-button],
body.non-dollar-currency .shopify-payment-button,
body.non-dollar-currency .product__shoppay-installments {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
  min-height: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  pointer-events: none !important;
  opacity: 0 !important;
}

@media (max-width: 480px) {
  .product__atc {
    gap: 8px !important;
  }
  .product__atc-row {
    gap: 8px !important;
    align-items: stretch !important;
    margin: 0 !important;
  }
  .quantity--input {
    min-width: 92px !important;
    max-width: 100px !important;
    height: 48px !important;
    min-height: 48px !important;
    max-height: 48px !important;
    margin: 0 !important;
    padding: 0 2px !important;
  }
  .quantity--input__button {
    width: 26px !important;
    font-size: 16px !important;
  }
  .quantity--input__input {
    width: 28px !important;
    font-size: 15px !important;
  }
  .product__atc .button--addToCart,
  .product__atc .button--primary,
  .product__atc .button--secondary,
  .product__atc button[data-buy-button] {
    height: 48px !important;
    min-height: 48px !important;
    max-height: 48px !important;
    font-size: 14px !important;
    gap: 6px !important;
    padding: 0 12px !important;
    margin: 0 !important;
  }
  .atc-button-icon {
    width: 16px !important;
    height: 16px !important;
  }
}

/* 5. Luxury Trust Bar (Exact Screenshot Style) */
.product-luxury-trust-bar {
  display: flex !important;
  align-items: stretch !important;
  justify-content: space-between !important;
  border-top: 1px solid #e5e7eb !important;
  border-bottom: 1px solid #e5e7eb !important;
  padding: 16px 0 !important;
  margin: 22px 0 24px 0 !important;
  background: transparent !important;
