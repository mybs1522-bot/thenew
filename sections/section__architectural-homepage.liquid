    grid-template-columns: 1fr;
  }
  .arch-trust__grid {
    grid-template-columns: 1fr;
    gap: 24px;
  }
}
</style>

<script>
(function() {
  function syncHomepagePrices() {
    var rawEls = document.querySelectorAll('#arch-hp [data-price-raw]');
    var activeCurrency = (window.bstore && window.bstore.get('currentCurrency')) || (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';
    var baseCurrency = (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) || 'USD';

    if (window.Currency && typeof window.Currency.convert === 'function' && window.BoosterTheme && window.BoosterTheme.cfx) {
      var format = window.BoosterTheme.cfx.getFormat(activeCurrency) || '{{amount}}';
      rawEls.forEach(function(el) {
        var rawPrice = parseInt(el.getAttribute('data-price-raw'), 10);
        if (!isNaN(rawPrice) && rawPrice > 0) {
          try {
            var converted = window.Currency.convert(rawPrice, baseCurrency, activeCurrency);
            var formatted = window.BoosterTheme.cfx.formatMoney(converted, format);
            if (formatted) {
              formatted = formatted.replace(/Rs\.?\s*/g, '₹');
              el.innerHTML = formatted;
              el.dataset.currency = activeCurrency;
            }
          } catch(e) {}
        }
      });
    } else {
      rawEls.forEach(function(el) {
        if (el && el.textContent && el.textContent.includes('Rs')) {
          el.textContent = el.textContent.replace(/Rs\.?\s*/g, '₹');
        }
      });
    }
  }

  syncHomepagePrices();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', syncHomepagePrices);
  }

  window.addEventListener('load', syncHomepagePrices);
  document.addEventListener('booster:initialized', syncHomepagePrices);
  document.addEventListener('booster:loaded', syncHomepagePrices);
  document.addEventListener('booster:currency:changed', function() {
    setTimeout(syncHomepagePrices, 20);
  });
  document.addEventListener('booster:geo:visitor', function() {
    setTimeout(syncHomepagePrices, 20);
  });
  document.addEventListener('booster:content:update', function() {
    setTimeout(syncHomepagePrices, 20);
  });

  var attempts = 0;
  var timer = setInterval(function() {
    syncHomepagePrices();
    attempts++;
    if ((window.Currency && window.BoosterTheme && window.BoosterTheme.cfx) || attempts > 15) {
      clearInterval(timer);
    }
  }, 200);
})();
</script>

