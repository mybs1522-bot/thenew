      img: '{{ "elevations.png" | asset_url }}',
      sections: [
        { name: 'Sunpath', items: ['Reading solar orientation', 'Minimizing heat & glare', 'Window overhang sizing', 'Passive cooling rules'] },
        { name: 'Ventilation', items: ['Wind direction analysis', 'Natural cross-breeze', 'Wind-break landscape', 'Window placement'] },
        { name: 'Site Planning', items: ['Slopes & site drainage', 'Foundation setbacks', 'Patio & deck zoning', 'Grading & walkways'] },
        { name: 'Facade Details', items: ['Climate responsive exterior', 'Proportion & material mix', 'Outdoor lighting rules', 'Low-maintenance plants'] }
      ]
    }
  ];

  var activeIndex = 0;

  window.lp6SelectCurriculum = function(index) {
    activeIndex = (index + curriculumData.length) % curriculumData.length;
    var book = curriculumData[activeIndex];

    var tabBtns = document.querySelectorAll('#lp6CurrTabs .lp6-curr-tab-btn');
    tabBtns.forEach(function(btn, i) {
      if (i === activeIndex) btn.classList.add('active');
      else btn.classList.remove('active');
    });

    var titleEl = document.getElementById('lp6CurrTitle');
    var imgEl = document.getElementById('lp6CurrImg');
    var gridEl = document.getElementById('lp6CurrGrid');

    if (titleEl) titleEl.textContent = book.title;
    if (imgEl) imgEl.src = book.img;

    if (gridEl) {
      var html = '';
      book.sections.forEach(function(sec) {
        html += '<div class="lp6-curr-sec-col">';
        html += '  <div class="lp6-curr-sec-title">' + sec.name + '</div>';
        html += '  <ul class="lp6-curr-list">';
        sec.items.forEach(function(item) {
          html += '    <li>' + item + '</li>';
        });
        html += '  </ul>';
        html += '</div>';
      });
      gridEl.innerHTML = html;
    }
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      lp6SelectCurriculum(0);
    });
  } else {
    lp6SelectCurriculum(0);
  }
})();

  /* ══════════════════════════════════════════════════
     INSIDE BOOKS - MARQUEE LIGHTBOX LOGIC
     ══════════════════════════════════════════════════ */
  var insideBooksImages = [
    '{{ "inside-kitchen-layout.png" | asset_url }}',
    '{{ "inside-countertop-height.png" | asset_url }}',
    '{{ "inside-fridge-placement.png" | asset_url }}',
    '{{ "inside-prep-station.png" | asset_url }}',
    '{{ "inside-kitchen-ventilation.png" | asset_url }}',
    '{{ "inside-bed-sizes.png" | asset_url }}',
    '{{ "inside-living-circulation.png" | asset_url }}',
    '{{ "inside-door-placement.png" | asset_url }}',
    '{{ "inside-stair-nosing.png" | asset_url }}',
    '{{ "inside-handrail-profiles.png" | asset_url }}',
    '{{ "inside-floor-levels.png" | asset_url }}',
    '{{ "inside-flat-roof.png" | asset_url }}',
    '{{ "inside-site-drainage.png" | asset_url }}',
    '{{ "inside-trees-wind.png" | asset_url }}'
  ];

  var currentInsideModalIdx = 0;

  window.lp6OpenInsideModal = function(idx) {
    currentInsideModalIdx = (idx + insideBooksImages.length) % insideBooksImages.length;
    var modal = document.getElementById('lp6InsideModal');
    var imgEl = document.getElementById('lp6ModalImg');
    if (imgEl) imgEl.src = insideBooksImages[currentInsideModalIdx];
    if (modal) {
      modal.style.display = 'flex';
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  };

  window.lp6CloseInsideModal = function(event) {
    if (event && event.target && event.target.closest('.lp6-modal-dialog') && !event.target.classList.contains('lp6-modal-close')) {
      return;
    }
    var modal = document.getElementById('lp6InsideModal');
    if (modal) {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  };

  window.lp6ModalNav = function(direction) {
    lp6OpenInsideModal(currentInsideModalIdx + direction);
  };

  window.addEventListener('keydown', function(e) {
    var modal = document.getElementById('lp6InsideModal');
    if (!modal || modal.style.display === 'none') return;
    if (e.key === 'Escape') lp6CloseInsideModal();
    else if (e.key === 'ArrowLeft') lp6ModalNav(-1);
    else if (e.key === 'ArrowRight') lp6ModalNav(1);
  });

</script>
