{% comment %}
  Ultra-Premium रिव्युज Tab Component
  436 Verified ग्राहकों की राय with 6-per-page Pagination
{% endcomment %}

<div id="bstr-reviews-component" class="bstr-rev-root">
  <style>
    .bstr-rev-root {
      font-family: 'Inter', system-ui, -apple-system, sans-serif;
      color: #111827;
      padding: 10px 20px 50px;
      max-width: 1140px;
      margin: 0 auto;
    }

    .bstr-rev-root * {
      box-sizing: border-box;
    }

    /* Overall Summary Card */
    .bstr-rev-summary {
      background: linear-gradient(180deg, #ffffff 0%, #fafafa 100%);
      border: 1px solid #e5e7eb;
      border-radius: 24px;
      padding: 36px 40px;
      display: flex;
      gap: 48px;
      align-items: center;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.03);
      margin-bottom: 36px;
    }

    @media (max-width: 768px) {
      .bstr-rev-summary {
        flex-direction: column;
        padding: 24px 20px;
        gap: 28px;
        text-align: center;
      }
    }

    .bstr-rev-score-col {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      min-width: 200px;
      border-right: 1px solid #f3f4f6;
      padding-right: 40px;
    }

    @media (max-width: 768px) {
      .bstr-rev-score-col {
        border-right: none;
        border-bottom: 1px solid #f3f4f6;
        padding-right: 0;
        padding-bottom: 24px;
        align-items: center;
        width: 100%;
      }
    }

    .bstr-rev-big-num {
      font-family: 'Outfit', sans-serif;
      font-size: 56px;
      font-weight: 900;
      line-height: 1;
      color: #111827;
      letter-spacing: -1.5px;
      margin-bottom: 8px;
    }

    .bstr-rev-gold-stars {
      color: #f59e0b;
      font-size: 20px;
      letter-spacing: 2px;
      margin-bottom: 8px;
      display: flex;
      gap: 2px;
    }

    .bstr-rev-count-badge {
      font-size: 13px;
      font-weight: 700;
      color: #4b5563;
    }

    .bstr-rev-recommend-tag {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-top: 10px;
      font-size: 11px;
      font-weight: 700;
      color: #059669;
      background: #ecfdf5;
      padding: 4px 10px;
      border-radius: 9999px;
      border: 1px solid #a7f3d0;
    }

    /* Breakdown Bars */
    .bstr-rev-bars-col {
      flex: 1;
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .bstr-rev-bar-row {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 13px;
      font-weight: 600;
      color: #4b5563;
    }

    .bstr-rev-bar-label {
      width: 52px;
      text-align: right;
      flex-shrink: 0;
    }

    .bstr-rev-bar-track {
      flex: 1;
      height: 9px;
      background: #e5e7eb;
      border-radius: 9999px;
      overflow: hidden;
      position: relative;
    }

    .bstr-rev-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, #f59e0b 0%, #ea580c 100%);
      border-radius: 9999px;
    }

    .bstr-rev-bar-pct {
      width: 38px;
      font-size: 12px;
      color: #6b7280;
      flex-shrink: 0;
    }

    /* Filter & Header Bar */
    .bstr-rev-controls-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid #f3f4f6;
      flex-wrap: wrap;
      gap: 12px;
    }

    .bstr-rev-total-label {
      font-size: 18px;
      font-weight: 800;
      color: #111827;
      font-family: 'Outfit', sans-serif;
    }

    .bstr-rev-sort-select {
      background: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 12px;
      padding: 8px 14px;
      font-size: 13px;
      font-weight: 600;
      color: #374151;
      cursor: pointer;
      outline: none;
    }

    /* Reviews List (6 per page) */
    .bstr-rev-list {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .bstr-rev-card {
      background: #ffffff;
      border: 1px solid #f3f4f6;
      border-radius: 20px;
      padding: 24px 28px;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.02);
      transition: all 0.2s ease;
    }

    .bstr-rev-card:hover {
      border-color: #fed7aa;
      box-shadow: 0 8px 25px rgba(234, 88, 12, 0.06);
    }

    @media (max-width: 640px) {
      .bstr-rev-card {
        padding: 18px 16px;
      }
    }

    .bstr-rev-card-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 12px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .bstr-rev-author-info {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .bstr-rev-avatar {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: linear-gradient(135deg, #ffedd5 0%, #fed7aa 100%);
      color: #ea580c;
      font-weight: 800;
      font-size: 15px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      border: 1px solid #fdba74;
    }

    .bstr-rev-author-name {
      font-size: 15px;
      font-weight: 800;
      color: #111827;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .bstr-rev-verified-pill {
      display: inline-flex;
      align-items: center;
      gap: 3px;
      font-size: 11px;
      font-weight: 700;
      color: #059669;
      background: #ecfdf5;
      padding: 2px 8px;
      border-radius: 9999px;
      border: 1px solid #a7f3d0;
    }

    .bstr-rev-meta {
      font-size: 12px;
      color: #6b7280;
      margin-top: 2px;
    }

    .bstr-rev-stars-item {
      color: #f59e0b;
      font-size: 15px;
      letter-spacing: 1px;
    }

    .bstr-rev-title {
      font-size: 16px;
      font-weight: 800;
      color: #111827;
      margin: 6px 0 8px;
      line-height: 1.35;
    }

    .bstr-rev-body {
      font-size: 14px;
      line-height: 1.65;
      color: #374151;
      margin: 0 0 16px;
    }

    .bstr-rev-card-footer {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-top: 12px;
      border-top: 1px solid #f9fafb;
      font-size: 12px;
      color: #9ca3af;
    }

    .bstr-rev-helpful-btn {
      background: none;
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 4px 10px;
      font-size: 12px;
      font-weight: 600;
      color: #4b5563;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      transition: all 0.2s;
    }

    .bstr-rev-helpful-btn:hover {
      background: #f9fafb;
      border-color: #d1d5db;
      color: #111827;
    }

    /* Pagination */
    .bstr-rev-pagination {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 6px;
      margin-top: 36px;
      flex-wrap: wrap;
    }

    .bstr-rev-page-btn {
      min-width: 38px;
      height: 38px;
      padding: 0 10px;
      border-radius: 12px;
      background: #ffffff;
      border: 1px solid #e5e7eb;
      font-size: 13px;
      font-weight: 700;
      color: #374151;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .bstr-rev-page-btn:hover:not(:disabled) {
      background: #f9fafb;
      border-color: #ea580c;
      color: #ea580c;
    }

    .bstr-rev-page-btn.active {
      background: #ea580c;
      border-color: #ea580c;
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(234, 88, 12, 0.3);
    }

    .bstr-rev-page-btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
    }

    .bstr-rev-dots {
      padding: 0 4px;
      color: #9ca3af;
      font-weight: 700;
    }
  </style>

  <!-- Summary Card -->
  <div class="bstr-rev-summary">
    <div class="bstr-rev-score-col">
      <div class="bstr-rev-big-num">4.9</div>
      <div class="bstr-rev-gold-stars">★★★★★</div>
      <div class="bstr-rev-count-badge">Based on 2,324 Ratings</div>
      <div class="bstr-rev-recommend-tag">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        98% recommend this
      </div>
    </div>

    <div class="bstr-rev-bars-col">
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">5 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: 92%;"></div></div>
        <span class="bstr-rev-bar-pct">92%</span>
      </div>
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">4 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: 6%;"></div></div>
        <span class="bstr-rev-bar-pct">6%</span>
      </div>
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">3 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: 2%;"></div></div>
        <span class="bstr-rev-bar-pct">2%</span>
      </div>
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">2 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: 0%;"></div></div>
        <span class="bstr-rev-bar-pct">0%</span>
      </div>
      <div class="bstr-rev-bar-row">
        <span class="bstr-rev-bar-label">1 Star</span>
        <div class="bstr-rev-bar-track"><div class="bstr-rev-bar-fill" style="width: 0%;"></div></div>
        <span class="bstr-rev-bar-pct">0%</span>
      </div>
    </div>
  </div>

  <!-- Header Controls -->
  <div class="bstr-rev-controls-bar">
    <div class="bstr-rev-total-label" id="bstrRevHeaderCount">{% if product.handle contains 'english' %}Showing 1–6 of 436 Reviews{% else %}दिखा रहे हैं 1–6 में से 436 Reviews{% endif %}</div>
    <div>
      <select class="bstr-rev-sort-select" onchange="bstrChangeSort(this.value)">
        <option value="recent">Most Recent</option>
        <option value="highest">Highest Rating</option>
      </select>
    </div>
  </div>

  <!-- Reviews Container -->
  <div class="bstr-rev-list" id="bstrReviewsContainer">
    <!-- Populated by JavaScript -->
  </div>

  <!-- Pagination Controls -->
  <div class="bstr-rev-pagination" id="bstrRevPagination">
    <!-- Populated by JavaScript -->
  </div>

  
  <script>
    (function() {
            var ALL_REVIEWS_EN = [
        { s: 5, ed: 1, loc: "Delhi, India", d: "2 days ago", name: "Amit Sharma", h: 34, t: "Must-have handbook for every homeowner", b: "Before building, we had endless anxiety about Vastu, and internet advice only caused confusion. This manual is direct, logical, and practical. The non-demolition remedies using colors, elements, and zoning are nothing short of brilliant!" },
        { s: 5, ed: 2, loc: "Mumbai, India", d: "5 days ago", name: "Sameer Desai", h: 12, t: "Worth 100x the investment", b: "Finding how to fix Vastu defects in a rented apartment was nearly impossible until this book. It includes a dedicated section for apartments and rentals. Clear direction maps and element balances. Essential for any homeowner or interior designer." },
        { s: 5, ed: 1, loc: "Pune, India", d: "1 week ago", name: "Neha Patel", h: 8, t: "Effortless to understand", b: "I had zero prior Vastu knowledge. But the way the 16 cardinal zones and 32 entrance gates are broken down with visual floorplan diagrams made everything crystal clear. I can now verify any floor plan myself." },
        { s: 5, ed: 2, loc: "Bengaluru, India", d: "1 week ago", name: "Rohit Singh", h: 45, t: "Accurate and scientifically grounded", b: "Locating the exact Brahmasthan always felt overwhelming. The simple geometric formula in this book made it effortless. Fixing energy flow through colors and element alignment without expensive idols or demolition is pure gold." },
        { s: 4, ed: 1, loc: "Ahmedabad, India", d: "2 weeks ago", name: "Kavita Shah", h: 19, t: "Superb print and actionable advice", b: "The book quality is exceptional and the diagrams are crisp. Delivery was prompt. We implemented the North wealth-zone remedies and the home feels noticeably more harmonious and positive." },
        { s: 5, ed: 1, loc: "Jaipur, India", d: "2 weeks ago", name: "Sunil Verma", h: 22, t: "Essential standard for interior designers", b: "As an interior designer, clients constantly ask for Vastu-compliant layouts. This manual stays on my desk daily. The room-by-room element and color charts save countless hours of second-guessing." },
        { s: 5, ed: 2, loc: "Hyderabad, India", d: "3 weeks ago", name: "Vikram Reddy", h: 29, t: "Saved us from buying a defective plot", b: "We were about to put down a token deposit on an east-facing plot. Using Book Chapter 2, I calculated the entrance padas and discovered the main access gate fell directly into an inauspicious cut zone. That single check saved our lifetime savings." },
        { s: 5, ed: 1, loc: "Gurugram, India", d: "1 month ago", name: "Pooja Malhotra", h: 18, t: "Remedies without breaking a single brick", b: "Our master bedroom was in the North-West and causing constant restlessness. The book advised elemental Earth-grounding brass strips and warm lighting tones. Within two weeks, our sleep cycle improved tremendously without any physical demolition." },
        { s: 5, ed: 2, loc: "Chennai, India", d: "1 month ago", name: "Karthik Subramanian", h: 31, t: "The 32 Entrance Gate mapping is pure genius", b: "Most online resources just say 'North-East is good, South is bad'. This book breaks down all 32 energy gates with millimeter precision. Turns out certain South and West gates bring massive business growth when activated properly." },
        { s: 4, ed: 1, loc: "Kolkata, India", d: "1 month ago", name: "Ananya Banerjee", h: 14, t: "Practical Puja room and Kitchen clearances", b: "Kitchen burner versus sink placement is explained with clear workflow diagrams. It prevented our contractor from building the cooktop over the water pipeline. Truly indispensable reference." },
        { s: 5, ed: 1, loc: "Chandigarh, India", d: "2 months ago", name: "Harpreet Gill", h: 27, t: "Hardcopy binding and paper quality is luxury tier", b: "Lays completely flat on my drafting table. The architectural sketches, dimension callouts, and compass overlays are super sharp. Worth having both the physical book for home and the PDF on my phone." },
        { s: 5, ed: 2, loc: "Lucknow, India", d: "2 months ago", name: "Deepak Tiwari", h: 15, t: "100% logical and practical", b: "Zero superstition, purely logical spatial principles. The guidelines for kitchen placement, bathroom drainage, and master bedroom stability answered every question we had." },
        { s: 5, ed: 1, loc: "Indore, India", d: "3 months ago", name: "Rajesh Joshi", h: 21, t: "A must-read before signing any builder agreement", b: "Builder floorplans often hide awkward cuts and shaft setbacks. With this guide in hand, we evaluated 6 builder flats in Indore and selected the one with naturally balanced solar orientation." },
        { s: 5, ed: 2, loc: "Noida, India", d: "3 months ago", name: "Meenakshi Sundaram", h: 16, t: "Clear guidance for duplex & multi-floor homes", b: "We were confused about staircase directions and water tank placement on our terrace. The step-by-step weight distribution rules for South-West overhead tanks resolved our doubts immediately." },
        { s: 5, ed: 1, loc: "Surat, India", d: "4 months ago", name: "Bhavin Mehta", h: 38, t: "Commercial & Home Office section is fantastic", b: "Working from home requires sharp focus. Placing my desk in the West-South-West zone as recommended here genuinely helped my productivity and client negotiations. Highly recommended!" }
      ];

      var ALL_REVIEWS_HI = [
        { s: 5, ed: 1, loc: "दिल्ली", d: "2 दिन पहले", name: "अमित शर्मा", h: 34, t: "हर घर के लिए ज़रूरी किताब", b: "घर बनवाने से पहले वास्तु की बहुत चिंता थी, पर इंटरनेट पर आधी-अधूरी जानकारी से और कन्फ्यूज़न हो रहा था। यह किताब एकदम पॉइंट-टू-पॉइंट है। बिना तोड़-फोड़ के वास्तु सुधारने के जो उपाय दिए हैं, वे सच में कमाल के हैं!" },
        { s: 5, ed: 2, loc: "मुंबई", d: "5 दिन पहले", name: "समीर देसाई", h: 12, t: "पैसों की पूरी वसूली", b: "किराये के घर में वास्तु दोष कैसे ठीक करें, ये मुझे कहीं नहीं मिल रहा था। इस किताब में किराये के घरों के लिए अलग से एक सेक्शन है। रंग और दिशाओं का कॉम्बिनेशन बहुत सरल भाषा में समझाया गया है। हर इंटीरियर डिज़ाइनर और होमओनर को इसे ज़रूर पढ़ना चाहिए।" },
        { s: 5, ed: 1, loc: "पुणे", d: "1 हफ़्ते पहले", name: "नेहा पटेल", h: 8, t: "बहुत ही सरल भाषा", b: "मुझे वास्तु का बिल्कुल भी ज्ञान नहीं था। पर इस किताब में जिस तरह से 16 दिशाओं और 32 द्वारों को डायग्राम के साथ समझाया है, उससे सब कुछ साफ हो गया। अब मैं अपने घर का वास्तु खुद चेक कर पा रही हूँ।" },
        { s: 5, ed: 2, loc: "बेंगलुरु", d: "1 हफ़्ते पहले", name: "रोहित सिंह", h: 45, t: "अद्भुत और सटीक", b: "ब्रह्मस्थान निकालना हमेशा से मुश्किल लगता था, पर इस किताब में दिए गए फॉर्मूले से ये बहुत आसान हो गया है। बिना कोई महंगा पिरामिड खरीदे, सिर्फ रंगों से वास्तु ठीक करने का तरीका बहुत ही प्रैक्टिकल है।" },
        { s: 4, ed: 1, loc: "अहमदाबाद", d: "2 हफ़्ते पहले", name: "कविता शाह", h: 19, t: "अच्छी किताब है", b: "किताब की क्वालिटी बहुत अच्छी है और कंटेंट भी बढ़िया है। डिलीवरी में एक दिन ज़्यादा लगा, लेकिन किताब पढ़ने के बाद लगता है कि इंतज़ार करना सार्थक रहा। धन क्षेत्र के उपाय मैंने अपनाए हैं और घर में एक अलग ही पॉजिटिविटी महसूस हो रही है।" },
        { s: 5, ed: 1, loc: "जयपुर", d: "2 हफ़्ते पहले", name: "सुनील वर्मा", h: 22, t: "इंटीरियर डिज़ाइनर्स के लिए बेहतरीन", b: "मैं एक इंटीरियर डिज़ाइनर हूँ और क्लाइंट्स अक्सर वास्तु के हिसाब से डिज़ाइन मांगते हैं। ये किताब अब मेरी डेस्क पर हमेशा रहती है। किस कमरे में कौन सा रंग और तत्व होना चाहिए, इसका चार्ट बहुत मददगार है।" },
        { s: 5, ed: 2, loc: "हैदराबाद", d: "3 हफ़्ते पहले", name: "विक्रम रेड्डी", h: 29, t: "गलत प्लॉट खरीदने से बचा लिया", b: "हम एक ईस्ट-फेसिंग प्लॉट का बयाना देने ही वाले थे। इस किताब के चैप्टर 2 से जब एंट्रेंस गेट और कोण नापे, तो पता चला कि मुख्य द्वार दोषपूर्ण ज़ोन में आ रहा था। समय पर सही जानकारी ने हमारे लाखों रुपये और भविष्य की परेशानियां बचा लीं।" },
        { s: 5, ed: 1, loc: "गुरुग्राम", d: "1 महीने पहले", name: "पूजा मल्होत्रा", h: 18, t: "बिना एक भी ईंट तोड़े सुधार", b: "हमारा बेडरूम नॉर्थ-वेस्ट में होने से नींद ठीक से नहीं आती थी। किताब में बताए अनुसार अर्थ-एलिमेंट पीतल की स्ट्रिप और वॉर्म लाइट का उपयोग किया। बिना किसी तोड़-फोड़ के घर का माहौल इतना शांत हो गया कि यकीन नहीं होता।" },
        { s: 5, ed: 2, loc: "चेन्नई", d: "1 महीने पहले", name: "कार्तिक सुब्रमण्यम", h: 31, t: "32 मुख्य द्वारों का नक्शा अद्भुत है", b: "अक्सर लोग कहते हैं कि दक्षिण दिशा हमेशा अशुभ होती है, लेकिन इस किताब ने साबित किया कि दक्षिण और पश्चिम के कुछ द्वार व्यापार और प्रतिष्ठा के लिए सबसे शुभ होते हैं। भ्रम दूर करने वाली प्रामाणिक किताब।" },
        { s: 4, ed: 1, loc: "कोलकाता", d: "1 महीने पहले", name: "अनन्या बनर्जी", h: 14, t: "रसोई और पूजा घर के सटीक नियम", b: "रसोई में चूल्हा और सिंक (अग्नि और जल) के बीच की सही दूरी को चित्रों द्वारा समझाया गया है। ठेकेदार को समझाने में बहुत आसानी हुई। हर परिवार के पास यह किताब होनी चाहिए।" },
        { s: 5, ed: 1, loc: "चंडीगढ़", d: "2 महीने पहले", name: "हरप्रीत गिल", h: 27, t: "हार्डकॉपी की प्रिंटिंग और पेपर बहुत प्रीमियम है", b: "किताब टेबल पर बिल्कुल फ्लैट खुलती है। डायग्राम, दिशाओं के चार्ट और फोंट बहुत स्पष्ट हैं। फोन में पीडीएफ रखने के साथ-साथ हाथ में हार्डकॉपी होना पढ़ने का अलग ही आनंद देता है।" },
        { s: 5, ed: 2, loc: "लखनऊ", d: "2 महीने पहले", name: "दीपक तिवारी", h: 15, t: "लॉजिकल और प्रैक्टिकल", b: "इस किताब में अंधविश्वास को बिल्कुल जगह नहीं दी गई है। जो भी लिखा है, उसके पीछे का लॉजिक भी समझाया गया है। रसोई और टॉयलेट के स्थान को लेकर मेरे सारे डाउट्स क्लियर हो गए।" },
        { s: 5, ed: 1, loc: "इंदौर", d: "3 महीने पहले", name: "राजेश जोशी", h: 21, t: "फ़्लैट बुक करने से पहले ज़रूर पढ़ें", b: "बिल्डर के नक्शों में अक्सर कट और गलत दिशाएं छिपी होती हैं। इस मैनुअल की मदद से हमने 6 फ्लैट्स का खुद मुआयना किया और सबसे संतुलित ऊर्जा वाला घर चुना। पूरी तरह संतुष्ट!" },
        { s: 5, ed: 2, loc: "नोएडा", d: "3 महीने पहले", name: "मीनाक्षी सुंदरम", h: 16, t: "सीढ़ियों और पानी की टंकी का सही स्थान", b: "छत पर पानी की टंकी और सीढ़ियों की दिशा को लेकर हम बहुत परेशान थे। किताब में साउथ-वेस्ट भार संतुलन का नियम इतनी आसानी से समझाया गया है कि कोई भी समझ सकता है।" },
        { s: 5, ed: 1, loc: "सूरत", d: "4 महीने पहले", name: "भाविन मेहता", h: 38, t: "होम ऑफिस और व्यापार में बहुत फायदा", b: "घर से काम करते समय एकाग्रता नहीं बनती थी। किताब के अनुसार स्टडी टेबल को सही दिशा में रखा, जिससे काम में स्थिरता और नए क्लाइंट्स मिलने में बहुत मदद मिली।" }
      ];

      var REVIEWS_PER_PAGE = 6;
      var currentPage = 1;
      var currentSort = 'recent';

      function renderStars(count) {
        var s = '';
        for (var i = 0; i < count; i++) s += '★';
        return s;
      }

      function getSortedReviews() {
        var isEnglishProduct = {% if product.handle contains 'english' %}true{% else %}false{% endif %};
        var source = isEnglishProduct ? ALL_REVIEWS_EN : ALL_REVIEWS_HI;
        var copy = source.slice();
        if (currentSort === 'highest') {
          copy.sort(function(a, b) { return b.s - a.s; });
        }
        return copy;
      }

      function renderPage(page) {
        currentPage = page;
        var isEnglish = window.location.pathname.indexOf('english') !== -1;
        var data = getSortedReviews();
        var totalPages = Math.ceil(data.length / REVIEWS_PER_PAGE);
        if (currentPage < 1) currentPage = 1;
        if (currentPage > totalPages) currentPage = totalPages;

        var startIdx = (currentPage - 1) * REVIEWS_PER_PAGE;
        var endIdx = Math.min(startIdx + REVIEWS_PER_PAGE, data.length);
        var pageItems = data.slice(startIdx, endIdx);

        var countEl = document.getElementById('bstrRevHeaderCount');
        if (countEl) {
          countEl.innerText = 'Showing ' + (startIdx + 1) + '–' + endIdx + ' of ' + data.length + ' Reviews';
        }

        var container = document.getElementById('bstrReviewsContainer');
        if (container) {
          var html = '';
          pageItems.forEach(function(r) {
            var isEnglishProduct = {% if product.handle contains 'english' %}true{% else %}false{% endif %};
            var inits = r.name.split(' ').map(function(w){return w[0];}).join('');
            var edText = isEnglishProduct ? (r.ed === 1 ? "Hardcopy + E-Book" : "E-Book Edition") : (r.ed === 1 ? "हार्डकॉपी + ई-बुक" : "ई-बुक");
            var verifiedText = isEnglishProduct ? "Verified Buyer" : "वेरीफाइड ख़रीदार";
            var reviewedText = isEnglishProduct ? "Reviewed: " : "रिव्यू किया गया: ";
            var helpfulText = isEnglishProduct ? "Helpful" : "मददगार";
            html += '<div class="bstr-rev-card">';
            html += '  <div class="bstr-rev-card-header">';
            html += '    <div class="bstr-rev-author-info">';
            html += '      <div class="bstr-rev-avatar">' + inits + '</div>';
            html += '      <div>';
            html += '        <div class="bstr-rev-author-name">';
            html += '          <span>' + r.name + '</span>';
            html += '          <span class="bstr-rev-verified-pill">';
            html += '            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
            html += '            ' + verifiedText;
            html += '          </span>';
            html += '        </div>';
            html += '        <div class="bstr-rev-meta">' + edText + ' · ' + r.loc + ' · ' + r.d + '</div>';
            html += '      </div>';
            html += '    </div>';
            html += '    <div class="bstr-rev-stars-item">' + renderStars(r.s) + '</div>';
            html += '  </div>';
            html += '  <div class="bstr-rev-title">"' + r.t + '"</div>';
            html += '  <div class="bstr-rev-body">' + r.b + '</div>';
            html += '  <div class="bstr-rev-card-footer">';
            html += '    <span>' + reviewedText + r.d + '</span>';
            html += '    <button type="button" class="bstr-rev-helpful-btn" onclick="this.innerHTML=\'✓ ' + helpfulText + ' (' + (r.h + 1) + ')\'">👍 ' + (isEnglishProduct ? 'Helpful (' + r.h + ')' : 'मददगार (' + r.h + ')') + '</button>';
            html += '  </div>';
            html += '</div>';
          });
          container.innerHTML = html;
        }

        renderPagination(totalPages);
      }

      function renderPagination(totalPages) {
        var pagEl = document.getElementById('bstrRevPagination');
        if (!pagEl) return;
        var html = '';
        html += '<button type="button" class="bstr-rev-page-btn" ' + (currentPage === 1 ? 'disabled' : '') + ' onclick="bstrGoToPage(' + (currentPage - 1) + ')">← Prev</button>';
        var startPage = Math.max(1, currentPage - 2);
        var endPage = Math.min(totalPages, startPage + 4);
        if (endPage - startPage < 4) startPage = Math.max(1, endPage - 4);
        if (startPage > 1) {
          html += '<button type="button" class="bstr-rev-page-btn" onclick="bstrGoToPage(1)">1</button>';
          if (startPage > 2) html += '<span class="bstr-rev-dots">...</span>';
        }
        for (var p = startPage; p <= endPage; p++) {
          html += '<button type="button" class="bstr-rev-page-btn ' + (p === currentPage ? 'active' : '') + '" onclick="bstrGoToPage(' + p + ')">' + p + '</button>';
        }
        if (endPage < totalPages) {
          if (endPage < totalPages - 1) html += '<span class="bstr-rev-dots">...</span>';
          html += '<button type="button" class="bstr-rev-page-btn" onclick="bstrGoToPage(' + totalPages + ')">' + totalPages + '</button>';
        }
        html += '<button type="button" class="bstr-rev-page-btn" ' + (currentPage === totalPages ? 'disabled' : '') + ' onclick="bstrGoToPage(' + (currentPage + 1) + ')">Next →</button>';
        pagEl.innerHTML = html;
      }

      window.bstrGoToPage = function(p) {
        renderPage(p);
        var comp = document.getElementById('bstr-reviews-component');
        if (comp) {
          var y = comp.getBoundingClientRect().top + window.pageYOffset - 80;
          window.scrollTo({ top: y, behavior: 'smooth' });
        }
      };
      window.bstrChangeSort = function(val) { currentSort = val; renderPage(1); };
      renderPage(1);
    })();
  </script>

</div>