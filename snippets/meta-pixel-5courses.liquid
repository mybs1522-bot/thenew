<!-- Meta Pixel Management for 5 Courses Offer -->
<!-- Target Product: 5-courses-interior-exterior-design-ai (ID: 9319186694282, Variant: 50269007347850) -->
<!-- Active Primary Pixel: 2155894718322083 (Courses Design - Managed via Shopify CAPI & Web Pixel) -->
<!-- Blocks legacy books pixel 2085433195424016 and suppresses retired pixel 955923376982045 -->
<script>
(function() {
  var BLOCKED_PIXEL_IDS = ['2085433195424016', '955923376982045'];
  var ACTIVE_PIXEL_ID = '2155894718322083';

  // --- 1. SUPPRESS RETIRED & CONFLICTING PIXELS (Prevents beacon/fetch to old pixels) ---
  function isBlockedUrl(url) {
    if (typeof url !== 'string' || url.indexOf('facebook.com/tr') === -1) return false;
    for (var i = 0; i < BLOCKED_PIXEL_IDS.length; i++) {
      if (url.indexOf(BLOCKED_PIXEL_IDS[i]) !== -1) return true;
    }
    return false;
  }

  if (window.navigator && window.navigator.sendBeacon) {
    var origSendBeacon = window.navigator.sendBeacon;
    window.navigator.sendBeacon = function(url, data) {
      if (isBlockedUrl(url)) {
        return true;
      }
      return origSendBeacon.apply(this, arguments);
    };
  }

  if (window.fetch) {
    var origFetch = window.fetch;
    window.fetch = function(input, init) {
      var url = typeof input === 'string' ? input : (input && input.url ? input.url : '');
      if (isBlockedUrl(url)) {
        return Promise.resolve(new Response('{}', { status: 200 }));
      }
      return origFetch.apply(this, arguments);
    };
  }

  // --- 2. CAPTURE fbclid AND WRITE FIRST-PARTY _fbc COOKIE (Required for 9.0+ EMQ) ---
  try {
    var urlParams = new URLSearchParams(window.location.search);
    var fbclid = urlParams.get('fbclid');
    if (fbclid) {
      var now = Date.now();
      var fbcValue = 'fb.1.' + now + '.' + fbclid;
      var domain = window.location.hostname.replace(/^www\./, '');
      var expires = new Date(now + 90 * 24 * 60 * 60 * 1000).toUTCString();
      document.cookie = '_fbc=' + fbcValue + '; path=/; domain=.' + domain + '; expires=' + expires + '; SameSite=Lax';
    }
  } catch (e) {}

  // --- 3. FILTER FBQ CALLS TO PREVENT CONFLICTS ---
  if (window.fbq) {
    var origFbq = window.fbq;
    var filteredFbq = function() {
      var args = Array.prototype.slice.call(arguments);
      // Suppress init or trackSingle calls targeting retired pixels
      if ((args[0] === 'init' || args[0] === 'trackSingle' || args[0] === 'trackSingleCustom') &&
          BLOCKED_PIXEL_IDS.indexOf(String(args[1])) !== -1) {
        return;
      }
      return origFbq.apply(window, args);
    };
    for (var prop in origFbq) {
      if (origFbq.hasOwnProperty(prop)) {
        filteredFbq[prop] = origFbq[prop];
      }
    }
    window.fbq = filteredFbq;
  }
})();
</script>
