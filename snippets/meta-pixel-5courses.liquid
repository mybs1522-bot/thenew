        content_ids: [TARGET_VARIANT_ID],
        content_type: 'product',
        contents: [{
          id: TARGET_VARIANT_ID,
          quantity: 1,
          item_price: 49.00
        }],
        value: 49.00,
        currency: 'USD'
      });
    }

    document.querySelectorAll('[data-buy-button], .button--primary, .button--addToCart, .button--buy-now, .c5b-enroll-btn').forEach(function(btn) {
