{% comment %}
  Sticky Bottom "Buy Now" Bar with Evergreen Urgency Timer (7h 37m 40s)
  - Triggers early on mobile as soon as the top fold / main Buy Now button scrolls out of view
  - Navigates DIRECTLY to Shopify Checkout (/cart/VARIANT:1) to bypass cart drawers & ensure 1-click checkout
  - Preserves URL query params (UTMs, discount codes)
  - Full iOS safe-area inset support & touch-friendly tap targets
{% endcomment %}

<div id="arch-sticky-buy-bar" class="arch-sticky-bar" aria-hidden="true">
  <div class="arch-sticky-bar__inner">
    
    <!-- Left: Evergreen Urgency Timer & Live Price -->
    <div class="arch-sticky-bar__info">
      
      <!-- Evergreen Countdown Timer -->
      <div class="arch-sticky-timer">
        <span class="arch-timer-pulse-dot"></span>
        <span class="arch-timer-label">Ends in:</span>
        <div class="arch-timer-display">
          <span class="arch-timer-box" id="archStickyHours">07</span><span class="arch-timer-sep">:</span><!--
          --><span class="arch-timer-box" id="archStickyMinutes">37</span><span class="arch-timer-sep">:</span><!--
          --><span class="arch-timer-box" id="archStickySeconds">40</span>
        </div>
      </div>

      <!-- Pricing Line: Crossed-out Compare Price + Big Highlight Sale Price -->
      <div class="arch-sticky-bar__meta">
        <div class="arch-sticky-bar__pricing">
          {% assign sticky_curr_var = product.selected_or_first_available_variant %}
          {% assign sticky_double_price = sticky_curr_var.price | times: 2 %}
          <span class="arch-sticky-bar__compare" id="archStickyCompare">
            {{ sticky_double_price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}
          </span>
          <span class="arch-sticky-bar__price" id="archStickyPrice">
            {{ sticky_curr_var.price | money | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' }}
          </span>
        </div>
        <span class="arch-sticky-badge-text">⚡ Instant Access</span>
      </div>

    </div>

    <!-- Right: High-Converting Direct-to-Checkout Buy Now Action Button -->
    <div class="arch-sticky-bar__action">
      <button type="button" id="archStickyBuyBtn" class="arch-sticky-btn" onclick="executeStickyBuyNow(this)" aria-label="Get All Courses directly to checkout">
        <svg class="arch-sticky-btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <path d="M16 10a4 4 0 0 1-8 0"></path>
        </svg>
        <span class="arch-sticky-btn__text">Get All Courses</span>
        <svg class="arch-sticky-btn__arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>
    </div>

  </div>
</div>

<style>
/* ─── STICKY BOTTOM BUY NOW BAR STYLING ─── */
.arch-sticky-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  width: 100%;
  z-index: 999999;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  border-top: 1px solid #e2e8f0;
  box-shadow: 0 -8px 25px rgba(0, 0, 0, 0.09), 0 -1px 3px rgba(0, 0, 0, 0.04);
  transform: translateY(115%);
  opacity: 0;
  pointer-events: none;
  transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.22s ease;
  box-sizing: border-box;
  padding-bottom: env(safe-area-inset-bottom, 0px);
}

.arch-sticky-bar.arch-sticky-bar--visible {
  transform: translateY(0);
  opacity: 1;
  pointer-events: auto;
}

body.has-arch-sticky-bar {
  padding-bottom: 74px !important;
}

.arch-sticky-bar__inner {
  max-width: 1180px;
  margin: 0 auto;
  padding: 10px 22px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-sizing: border-box;
}

/* Info Section (Stacked: Timer ABOVE Price) */
.arch-sticky-bar__info {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4px;
  flex: 1;
  min-width: 0;
}

/* Evergreen Countdown Timer */
.arch-sticky-timer {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: #fff7ed;
  border: 1px solid #fed7aa;
  padding: 3px 10px;
  border-radius: 9999px;
  box-shadow: 0 1px 3px rgba(234, 88, 12, 0.08);
  flex-shrink: 0;
}

.arch-timer-pulse-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #ea580c;
  display: inline-block;
  animation: archTimerPulse 1.6s infinite ease-in-out;
  flex-shrink: 0;
}

@keyframes archTimerPulse {
  0% {
    transform: scale(0.9);
    box-shadow: 0 0 0 0 rgba(234, 88, 12, 0.7);
  }
  70% {
    transform: scale(1.15);
    box-shadow: 0 0 0 6px rgba(234, 88, 12, 0);
  }
  100% {
    transform: scale(0.9);
    box-shadow: 0 0 0 0 rgba(234, 88, 12, 0);
  }
}

.arch-timer-label {
  font-size: 9.5px;
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: #9a3412;
}

.arch-timer-display {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-family: 'Space Grotesk', -apple-system, monospace;
  font-size: 11.5px;
  font-weight: 800;
  color: #ea580c;
  letter-spacing: -0.01em;
}

.arch-timer-box {
  display: inline-block;
  min-width: 15px;
  text-align: center;
}

.arch-timer-sep {
  opacity: 0.6;
  margin: 0 -1px;
}

/* Pricing Line (Underneath Timer) */
.arch-sticky-bar__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.arch-sticky-bar__pricing {
  display: flex;
  align-items: baseline;
  gap: 7px;
  line-height: 1;
}

.arch-sticky-bar__compare {
  font-family: 'Space Grotesk', -apple-system, sans-serif;
  font-size: 14.5px;
  font-weight: 600;
  color: #94a3b8;
  text-decoration: line-through;
  line-height: 1;
}

.arch-sticky-bar__price {
  font-family: 'Space Grotesk', -apple-system, sans-serif;
  font-size: 21px;
  font-weight: 900;
  color: #ea580c;
  letter-spacing: -0.01em;
  line-height: 1;
}

.arch-sticky-badge-text {
  font-size: 11px;
  font-weight: 700;
  color: #16a34a;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  padding: 1.5px 7px;
  border-radius: 9999px;
  white-space: nowrap;
  letter-spacing: 0.01em;
}

/* Action Button: BLACK & HIGH CONVERTING */
.arch-sticky-bar__action {
  flex-shrink: 0;
}

.arch-sticky-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;
  background: #09090b !important;
  color: #ffffff !important;
  -webkit-text-fill-color: #ffffff !important;
  font-family: 'Space Grotesk', -apple-system, sans-serif;
  font-size: 16px;
  font-weight: 800;
  letter-spacing: 0.02em;
  padding: 12px 28px;
  min-height: 48px;
  border-radius: 9999px;
  border: 1px solid #18181b;
  cursor: pointer;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.28), 0 2px 4px rgba(0, 0, 0, 0.12);
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  text-decoration: none;
  white-space: nowrap;
}

.arch-sticky-btn:hover {
  transform: translateY(-1px) scale(1.02);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.42);
  background: #18181b !important;
}

.arch-sticky-btn:active {
  transform: translateY(0) scale(0.98);
  background: #000000 !important;
}

.arch-sticky-btn__icon {
  flex-shrink: 0;
  stroke: #ffffff;
}

.arch-sticky-btn__arrow {
  flex-shrink: 0;
  stroke: #ffffff;
  transition: transform 0.2s ease;
}

.arch-sticky-btn:hover .arch-sticky-btn__arrow {
  transform: translateX(3px);
}

/* ─── MOBILE RESPONSIVE TWEAKS ─── */
@media (max-width: 640px) {
  body.has-arch-sticky-bar {
    padding-bottom: 82px !important;
  }
  .arch-sticky-bar__inner {
    padding: 8px 12px;
    gap: 10px;
    align-items: center;
  }
  .arch-sticky-bar__info {
    gap: 3px;
    min-width: 0;
    flex: 1 1 auto;
  }
  .arch-sticky-timer {
    padding: 2.5px 8px;
    gap: 4px;
  }
  .arch-timer-label {
    font-size: 8.5px;
  }
  .arch-timer-display {
    font-size: 11px;
  }
  .arch-sticky-bar__meta {
    gap: 6px;
    flex-wrap: wrap;
  }
  .arch-sticky-bar__pricing {
    gap: 6px;
    align-items: baseline;
  }
  .arch-sticky-bar__compare {
    font-size: 14px;
    font-weight: 600;
  }
  .arch-sticky-bar__price {
    font-size: 22px !important;
    font-weight: 900 !important;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .arch-sticky-badge-text {
    display: none; /* keep clean on tiny mobile screens */
  }
  .arch-sticky-bar__action {
    flex: 0 0 auto;
    min-width: 155px;
  }
  .arch-sticky-btn {
    width: 100%;
    min-width: 155px;
    padding: 11px 16px;
    font-size: 14.5px;
    font-weight: 800;
    min-height: 46px;
    gap: 6px;
    letter-spacing: 0.01em;
    box-shadow: 0 3px 14px rgba(0, 0, 0, 0.32);
    white-space: nowrap;
  }
  .arch-sticky-btn__icon {
    width: 16px;
    height: 16px;
  }
  .arch-sticky-btn__arrow {
    width: 14px;
    height: 14px;
  }
}

@media (max-width: 360px) {
  .arch-sticky-bar__inner {
    padding: 6px 8px;
    gap: 6px;
  }
  .arch-sticky-bar__action {
    min-width: 136px;
  }
  .arch-sticky-btn {
    min-width: 136px;
    padding: 10px 10px;
    font-size: 13px;
    gap: 4px;
  }
  .arch-sticky-btn__icon {
    width: 14px;
    height: 14px;
  }
  .arch-sticky-btn__arrow {
    width: 12px;
    height: 12px;
  }
  .arch-sticky-bar__price {
    font-size: 20px !important;
  }
}

@media (min-width: 480px) and (max-width: 640px) {
  .arch-sticky-badge-text {
    display: inline-block;
  }
}
</style>

<script>
(function() {
  /* 1. EVERGREEN COUNTDOWN TIMER (7 Hours 37 Min 40 Sec) */
  const DURATION_SECONDS = 7 * 3600 + 37 * 60 + 40; // 27,460 seconds
  const STORAGE_KEY = 'arch_evergreen_deadline_v1';

  function getDeadline() {
    let stored = localStorage.getItem(STORAGE_KEY);
    const now = Date.now();
    if (!stored || isNaN(parseInt(stored, 10)) || parseInt(stored, 10) <= now) {
      const newDeadline = now + DURATION_SECONDS * 1000;
      localStorage.setItem(STORAGE_KEY, newDeadline);
      return newDeadline;
    }
    return parseInt(stored, 10);
  }

  const deadline = getDeadline();

  function updateTimer() {
    const now = Date.now();
    let diff = Math.max(0, Math.floor((deadline - now) / 1000));

    if (diff <= 0) {
      const resetDeadline = Date.now() + DURATION_SECONDS * 1000;
      localStorage.setItem(STORAGE_KEY, resetDeadline);
      diff = DURATION_SECONDS;
    }

    const h = Math.floor(diff / 3600);
    const m = Math.floor((diff % 3600) / 60);
    const s = diff % 60;

    const hStr = String(h).padStart(2, '0');
    const mStr = String(m).padStart(2, '0');
    const sStr = String(s).padStart(2, '0');

    const elH = document.getElementById('archStickyHours');
    const elM = document.getElementById('archStickyMinutes');
    const elS = document.getElementById('archStickySeconds');

    const atcH = document.getElementById('atcPillHours');
    const atcM = document.getElementById('atcPillMinutes');
    const atcS = document.getElementById('atcPillSeconds');

    if (elH) elH.textContent = hStr;
    if (elM) elM.textContent = mStr;
    if (elS) elS.textContent = sStr;
    if (atcH) atcH.textContent = hStr;
    if (atcM) atcM.textContent = mStr;
    if (atcS) atcS.textContent = sStr;
  }

  setInterval(updateTimer, 1000);
  updateTimer();

  /* 2. SCROLL DETECTION: SHOW AS SOON AS USER SCROLLS PAST MAIN BUY BUTTON */
  function getMainBuyArea() {
    return document.querySelector('.product__atc') ||
           document.querySelector('[data-buy-button]') ||
           document.querySelector('.product__atc-row') ||
           document.querySelector('.product__price--holder') ||
           document.querySelector('.arch-pill-timer-wrap');
  }

  function handleScrollVisibility() {
    const bar = document.getElementById('arch-sticky-buy-bar');
    if (!bar) return;

    const mainBuyEl = getMainBuyArea();
    const isMobile = window.innerWidth <= 768;
    let shouldShow = false;

    if (mainBuyEl) {
      const rect = mainBuyEl.getBoundingClientRect();
      // On mobile: show immediately once the primary ATC button scrolls out of viewport
      // or if user scrolled down > 240px
      if (isMobile) {
        shouldShow = (rect.bottom < 50) || (window.scrollY > 240);
      } else {
        // Desktop: show once main buy element scrolls above the screen
        shouldShow = (rect.bottom < 0) || (window.scrollY > 400);
      }
    } else {
      // Fallback if main buy element not found in DOM
      shouldShow = window.scrollY > (isMobile ? 220 : 380);
    }

    if (shouldShow) {
      bar.classList.add('arch-sticky-bar--visible');
      bar.setAttribute('aria-hidden', 'false');
      document.body.classList.add('has-arch-sticky-bar');
    } else {
      bar.classList.remove('arch-sticky-bar--visible');
      bar.setAttribute('aria-hidden', 'true');
      document.body.classList.remove('has-arch-sticky-bar');
    }
  }

  window.addEventListener('scroll', handleScrollVisibility, { passive: true });
  window.addEventListener('resize', handleScrollVisibility, { passive: true });
  document.addEventListener('DOMContentLoaded', handleScrollVisibility);
  setTimeout(handleScrollVisibility, 400);

  /* 3. SYNC PRICE WITH SWATCH / VARIANT CHANGES */
  document.addEventListener('change', function(e) {
    if (e.target && (e.target.matches('[data-swatch-index]') || e.target.name === 'id')) {
      syncPrice();
    }
  });

  function syncPrice() {
    setTimeout(function() {
      const mainPrice = document.querySelector('.product__price .price--regular') ||
                        document.querySelector('.product__price') ||
                        document.querySelector('.product-page__price');
      let text = '';
      if (mainPrice) {
        text = mainPrice.innerText.trim().split('\n')[0].replace(/Rs\.?\s*/g, '₹');
        const stickyPrice = document.getElementById('archStickyPrice');
        if (stickyPrice && text) stickyPrice.textContent = text;
      }
      
      const stickyCompare = document.getElementById('archStickyCompare');
      if (stickyCompare && text) {
        const match = text.match(/[\d,.]+/);
        if (match) {
          const rawNum = parseFloat(match[0].replace(/,/g, ''));
          if (!isNaN(rawNum) && rawNum > 0) {
            const doubled = rawNum * 2;
            const fmt = (doubled % 1 === 0) ? Math.round(doubled).toString() : doubled.toFixed(2);
            stickyCompare.textContent = text.replace(match[0], fmt);
            stickyCompare.style.display = 'inline-block';
          }
        }
      }
    }, 120);
  }

  /* 4. EXECUTE BUY NOW ACTION (Direct 1-Click to Checkout) */
  window.executeStickyBuyNow = function(btn) {
    if (!btn) btn = document.getElementById('archStickyBuyBtn');
    if (btn) {
      btn.style.opacity = '0.85';
      btn.style.pointerEvents = 'none';
      const textSpan = btn.querySelector('.arch-sticky-btn__text');
      if (textSpan) textSpan.textContent = 'Redirecting...';
    }

    // Get current active variant ID
    let variantId = null;
    const variantInput = document.querySelector('[data-bstr-variant-input]') ||
                         document.querySelector('input[name="id"]');
    if (variantInput && variantInput.value) {
      variantId = variantInput.value;
    } else {
      variantId = '{{ product.selected_or_first_available_variant.id }}';
    }

    // Direct 1-Click to Checkout:
    // Navigating directly to /cart/VARIANT:1 creates checkout session instantly and bypasses cart drawer
    var checkoutUrl = '/cart/' + encodeURIComponent(variantId) + ':1';
    if (window.location.search) {
      var query = window.location.search.replace(/^\?/, '');
      if (query) {
        checkoutUrl += (checkoutUrl.indexOf('?') === -1 ? '?' : '&') + query;
      }
    }
    window.location.href = checkoutUrl;
  };

})();
</script>
