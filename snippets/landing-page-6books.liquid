  display: block;
  pointer-events: none;
  border-radius: 10px;
}

/* Lightbox Modal */
.lp6-inside-modal {
  position: fixed;
  inset: 0;
  z-index: 9999999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  box-sizing: border-box;
}

.lp6-modal-backdrop {
  position: fixed;
  inset: 0;
  background: rgba(10, 15, 25, 0.88);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
