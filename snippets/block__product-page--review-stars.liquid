</div>

<script>
  function scrollToProductReviews(event) {
    if (event) event.preventDefault();
    
    // 1. Find and activate Reviews tab
    var tabs = document.querySelectorAll('.tab--product');
    var reviewsTab = null;
    tabs.forEach(function(tab) {
      if (tab.textContent.toLowerCase().indexOf('review') !== -1) {
        reviewsTab = tab;
      }
    });

    if (reviewsTab) {
      reviewsTab.click();
    } else {
      var tabByAttr = document.querySelector('[onclick*="tab_reviews"]') || document.querySelector('[onclick*="tab--"]:last-of-type');
      if (tabByAttr) tabByAttr.click();
    }

    // 2. Ensure content container is active/displayed
    var reviewContainer = document.getElementById('tab--tab_reviews');
    if (reviewContainer) {
      reviewContainer.classList.add('tab--show');
    }

    // 3. Smooth scroll with offset for sticky header
    setTimeout(function() {
      var target = document.getElementById('bstr-reviews-component') || reviewContainer || reviewsTab;
      if (target) {
        var headerOffset = 80;
        var elementPosition = target.getBoundingClientRect().top;
        var offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        window.scrollTo({
          top: offsetPosition,
          behavior: 'smooth'
        });
      }
    }, 50);
  }

  function scrollToCurriculum(idx) {
    var aboutTab = document.querySelector('[onclick*="tab_synopsis"]') || document.querySelector('.tab--product');
    if (aboutTab) aboutTab.click();
    if (window.lp6SelectCurriculum) window.lp6SelectCurriculum(idx);
    var target = document.getElementById('landing-page-6books');
    if (target) {
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
</script>

<style>
  .book-editorial-rating-wrapper {
    cursor: pointer;
    transition: opacity 0.2s ease;
  }
  .book-editorial-rating-wrapper:hover .rating-count-text {
    text-decoration: underline;
    color: #ea580c;
  }

  /* Top Rating Books Ripple Animation */
  .top-rating-books-ripple-wrap {
    margin: 10px 0 8px 0;
    width: 100%;
    overflow: hidden;
  }

  .top-rating-books-track {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    gap: clamp(6px, 1.8vw, 12px);
    padding: 8px 2px 4px 2px;
  }

  .top-rating-book-item {
    flex: 0 0 clamp(42px, 12.5vw, 62px);
    width: clamp(42px, 12.5vw, 62px);
    display: flex;
    flex-direction: column;
    align-items: center;
    cursor: pointer;
    user-select: none;
  }

  .top-rating-book-cover {
    width: 100%;
    aspect-ratio: 1 / 1.38;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
    border: 1.5px solid #e2e8f0;
    background: #ffffff;
    
    
    will-change: transform, box-shadow;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .top-rating-book-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .top-rating-book-name {
    font-size: clamp(9px, 2vw, 10.5px);
    font-weight: 700;
    color: #475569;
    margin-top: 4px;
    text-align: center;
    line-height: 1.15;
    transition: color 0.2s ease;
  }

  .top-rating-book-pages {
    font-size: clamp(7.5px, 1.8vw, 9.5px);
    font-weight: 600;
    color: #64748b;
    margin-top: 2px;
    text-align: center;
    line-height: 1.15;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  

  .top-rating-book-item:hover .top-rating-book-cover {
    animation-play-state: paused;
    transform: scale(1.18) translateY(-7px);
    box-shadow: 0 14px 26px rgba(234, 88, 12, 0.35);
    border-color: #ea580c;
  }

  .top-rating-book-item:hover .top-rating-book-name {
    color: #ea580c;
  }

  .top-rating-book-item:hover .top-rating-book-pages {
    color: #ea580c;
  }
</style>

{% render 'kitchen-pre-price' %}


