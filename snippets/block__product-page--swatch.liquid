{% if product.variants.size > 1 %}

{% assign altSelector = settings.altSelectorList | downcase | split: ',' %}

{% if altSelector.size or settings.defaultSelector == "swatch" %}

{% assign colorArray = settings.colorSwatches | downcase | split: ',' %}
{% assign imageArray = settings.imageSwatches | downcase | split: ',' %}

{% assign optionIndex = "" %}
{% for option in product.options %}
{% assign tempOption = option | downcase %}
{% if imageArray contains tempOption %}
{% assign optionIndex = optionIndex | append: forloop.index0 | append: ',' %}
{% endif %}
{% endfor %}

{% assign optionIndex = optionIndex | split: ',' %}

{% if optionIndex.size %}
{% assign imageOptions = true %}
{% assign colorImages = "" %}
{% endif %}

{% endif %}

{% capture vArray %}{ {%- for variant in product.variants -%}
{%- assign var_double_price = variant.price | times: 2 -%}
{%- assign var_double_price_money = var_double_price | money | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' -%}
{%- assign var_price_money = variant.price | money | strip_html | replace: 'Rs. ', '₹' | replace: 'Rs.', '₹' | replace: 'Rs ', '₹' -%}
{%- if variant.featured_image != nil and imageOptions -%}
{%- assign img = variant.featured_image | img_url: '100x100' -%}
{%- for ix in optionIndex -%}
{%- assign idx = ix | plus: 0 -%}
{%- assign option = variant.options[idx] | handleize -%}
{%- assign colorImages = colorImages | append: idx | append: '##'  | append: option | append: '##' | append: img | append: "," -%}
{%- endfor -%}
{%-endif-%}"{{variant.id}}": {"sku": {{ variant.sku | json }}, "available": {{variant.available | json}} ,"id": {{variant.id | json}}, "price_raw": {{variant.price}}, "sale_raw": {{var_double_price}}, "price": {{var_price_money | json}}, "sale": {{var_double_price_money | json}}, "options": {{variant.options | json }} }{%- unless forloop.last -%},{% endunless -%}{%- endfor -%}}{%- endcapture %}

<noscript data-bstr-preselect="{{product.selected_or_first_available_variant.id}}" data-bstr-swatch="{{product.id}}">
{{vArray}}
</noscript>

<div class="product__swatches">
    {% assign avvars = product.variants | where: 'available', true %}
    {% for product_option in product.options_with_values %}
        {% assign product_option_lc = product_option.name | downcase %}
        {% assign index = forloop.index0 %}
        {% assign optix = 'option' | append: product_option.position %}
        {% assign selector_type = settings.defaultSelector %}
        {% if altSelector contains product_option_lc %}
            {% if settings.defaultSelector == "dropdown" %}
                {% assign selector_type = "swatch" %}
            {% else %}
                {% assign selector_type = "dropdown" %}
            {% endif %}
        {% endif %}
        <div class="swatches__holder">
        <h4 class="h-reset swatches__title">{{product_option.name}} <span data-swatch-selected-name="{{product.id}}-{{index}}"></span></h4>
        {% case selector_type %}
            {% when 'dropdown' %}
                <select data-swatch-index="{{product.id}}-{{index}}">
                    <option value="bstrSelectNill" selected>Select a {{product_option_lc}}</option>
                    {% for value in product_option.values %}
                        {% assign vars = avvars | where: optix, value %}
                        <option {% if vars.size == 0 %} disabled data-swatch-soldout="true"{% endif %} value="{{value | escape}}" data-swatch-index="{{product.id}}-{{index}}">{{value}}</option>
                    {% endfor %}
                </select>
            {% when 'swatch' %}
                {% assign ix = product_option.position | minus: 1 | append: '' %}
                {% if imageArray contains product_option_lc %}
                {% assign useImages = true %}
                {% else %}
                {% assign useImages = false %}
                {% endif %}
                <div class="luxury-swatches-grid">
                {% for value in product_option.values %}
                    {% assign vars = avvars | where: optix, value %}
                    {% assign all_vars = product.variants | where: optix, value %}
                    {% assign var = all_vars | first %}
                    {% assign is_available = true %}
                    {% if vars.size == 0 %}
                        {% assign is_available = false %}
                    {% endif %}
                    {% if colorArray contains product_option_lc or imageArray contains product_option_lc %}
                        <span class="lazyload swatch--color" {%-render 'swatch__custom-finder', value: value, colorImages: colorImages, useImages: useImages, ix: ix -%} data-swatch-option="{{value| escape}}" data-swatch-index="{{product.id}}-{{index}}" {% unless is_available %}data-swatch-soldout="true"{% endunless %}></span>
                    {% else %}
                        <div class="luxury-swatch-card {% if value contains 'Digital' or value contains 'E-Book' or value contains 'E-book' or value contains 'eBook' %}is-popular{% endif %}" data-swatch-option="{{value| escape}}" data-swatch-index="{{product.id}}-{{index}}" {% unless is_available %}data-swatch-soldout="true"{% endunless %}>
                            {% if value contains 'Digital' or value contains 'E-Book' or value contains 'E-book' or value contains 'eBook' %}
                                <div class="luxury-card-badge">★ INSTANT ACCESS</div>
                            {% elsif value contains 'Hard' or value == 'Hardcopy' %}
                                {% if is_available %}
                                    <div class="luxury-card-badge">★ BEST VALUE</div>
                                {% else %}
                                    <div class="luxury-card-badge sold-out">OUT OF STOCK</div>
                                {% endif %}
                            {% endif %}
                            <div class="luxury-card-inner">
                                <div class="luxury-card-radio">
                                    <span class="radio-dot"></span>
                                </div>
                                <div class="luxury-card-content">
                                    <div class="luxury-card-top-row">
                                        <span class="luxury-card-title">{{value | escape}}{% unless is_available %} <span class="luxury-soldout-tag">Out of Stock</span>{% endunless %}</span>
                                        {% if var %}
                                            <span class="luxury-card-price" {% unless is_available %}style="color: #94a3b8; text-decoration: line-through;"{% endunless %}>{{ var.price | money }}</span>
                                        {% endif %}
                                    </div>
                                    <span class="luxury-card-subtitle">
                                        {% if value contains 'Digital' or value contains 'PDF' or value contains 'E-book' or value contains 'E-Book' or value contains 'eBook' %}
                                            {% if product.handle contains '6-books' %}
                                                ⚡ Instant PDF Download · 800+ Pages · Lifetime Updates
                                            {% else %}
                                                ⚡ Instant PDF Download · 150+ Pages · Lifetime Updates
                                            {% endif %}
                                        {% elsif value == 'Hardcopy' or value contains 'Hard' %}
                                            {% if is_available %}
                                                📦 Deluxe Printed Book + Free Digital PDF
                                            {% else %}
                                                📦 Deluxe Printed Edition (Currently Out of Stock)
                                            {% endif %}
                                        {% else %}
                                            Full Access Edition
                                        {% endif %}
                                    </span>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                {% endfor %}
                </div>
        {% endcase %}
        </div>
    {% endfor %}
</div>

{% else %}
<div class="product__swatches default-edition-pill">
    <h4 class="h-reset swatches__title">Edition / Format</h4>
    <div class="default-edition-card">
        <span class="edition-name">Lifetime Access</span>
        <span class="edition-price">{{ product.price | money }}</span>
        <span class="edition-badge">In Stock</span>
    </div>
</div>
{% endif %}


{% comment %}
{% blockdef %}

{% endblockdef %}
{% endcomment %}