{%- if block.settings.color != "rgba(0,0,0,0)" -%}
<style>
.product__title--{{block.id}} {
    color: {{block.settings.color}};
}
</style>
{%- endif -%}
{%- if product.handle == '5-courses-interior-exterior-design-ai' -%}
<div class="product-luxury-eyebrow">
  <span class="eyebrow-pill">
    <span class="eyebrow-dot"></span>
    15-Day Course
  </span>
</div>
<h1 
class="h-reset product__title product__title--{{block.id}} 
font__family--{{-block.settings.fontFamily}} font__size--{{-block.settings.fontSize}} 
 {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
    <span class="product__title-prefix">5 Courses For</span>
    <span class="product__title-highlight">Interior &amp; Exterior Design + AI</span>
</h1>
<div class="product-devices-compatibility">
  <span class="pd-comp-text">For Both</span>
  <span class="pd-comp-pill">
    <svg class="pd-win-icon" width="14" height="14" viewBox="0 0 88 88" fill="none">
      <path d="M0 0H41.6V41.6H0V0Z" fill="#F25022"/>
      <path d="M46.4 0H88V41.6H46.4V0Z" fill="#7FBA00"/>
      <path d="M0 46.4H41.6V88H0V46.4Z" fill="#00A4EF"/>
      <path d="M46.4 46.4H88V88H46.4V46.4Z" fill="#FFB900"/>
    </svg>
    <span class="pd-device-name">Windows</span>
    <span class="pd-comp-amp">&amp;</span>
    <svg class="pd-mac-icon" width="13" height="13" viewBox="0 0 170 170" fill="currentColor">
      <path d="M150.37 130.25c-2.45 5.66-5.35 10.87-8.71 15.66-4.58 6.53-8.33 11.05-11.22 13.56-4.48 4.12-9.28 6.23-14.42 6.35-3.69 0-8.14-1.05-13.32-3.18-5.19-2.12-9.97-3.17-14.34-3.17-4.58 0-9.49 1.05-14.75 3.17-5.26 2.13-9.5 3.24-12.74 3.35-4.35.13-9.16-1.9-14.42-6.08-3.7-3.04-7.6-7.85-11.7-14.43-6.19-9.88-11.03-21.43-14.52-34.65-3.48-13.22-5.22-25.29-5.22-36.21 0-16.71 4.58-30.41 13.73-41.11 9.15-10.7 20.35-16.14 33.6-16.32 4.9 0 10.45 1.25 16.65 3.75 6.2 2.5 10.05 3.82 11.55 3.96 1.74-.27 5.76-1.66 12.05-4.18 6.29-2.52 11.83-3.68 16.62-3.48 12.3.67 22.42 5.09 30.34 13.26-10.88 6.53-16.21 15.77-15.99 27.72.22 9.57 3.86 17.63 10.92 24.18 7.06 6.55 15.35 10.33 24.87 11.34-2.18 6.53-4.9 13.3-8.16 20.3zM119.22 31.84c0-7.39 2.67-14.41 8.01-21.06 5.34-6.65 11.96-10.78 19.86-12.39.22 1.3.33 2.5.33 3.6 0 7.39-2.83 14.5-8.49 21.33-5.66 6.83-12.3 11-19.92 12.52-.22-1.3-.33-2.5-.33-4z"/>
    </svg>
    <span class="pd-device-name">macOS</span>
  </span>
  <span class="pd-comp-text">Devices</span>
</div>
{%- else -%}
<div class="product-luxury-eyebrow">
  <span class="eyebrow-pill">
    <span class="eyebrow-dot"></span>
    Bestseller in 26 Countries | Home Design
  </span>
</div>
<h1 
class="h-reset product__title product__title--{{block.id}} 
font__family--{{-block.settings.fontFamily}} font__size--{{-block.settings.fontSize}} 
 {% if block.settings.noMargin or noMargin %}margin__bottom--reduced{%endif-%}" {{block.shopify_attributes}}>
  {%- if product.title contains 'Interior' and product.title contains 'Exterior' and product.title contains 'Books' -%}
    <span class="product__title-prefix">6 Books For</span>
    <span class="product__title-highlight">Interior &amp; Exterior Design</span>
  {%- elsif product.title contains 'Interior' and product.title contains 'Exterior' and product.handle contains '6-books' -%}
    <span class="product__title-prefix">6 Books For</span>
    <span class="product__title-highlight">Interior &amp; Exterior Design</span>
  {%- else -%}
    {{ product.title }}
  {%- endif -%}
</h1>
{%- endif -%}

<style>
  .product__title,
  .product-page__title,
  h1.product__title {
    white-space: normal !important;
    line-height: 1.15 !important;
    margin-bottom: 14px !important;
  }
  .product__title-prefix {
    display: block !important;
    font-size: 30px !important;
    font-weight: 700 !important;
    color: #374151 !important;
    line-height: 1.18 !important;
    letter-spacing: -0.015em !important;
    margin-bottom: 4px !important;
    white-space: nowrap !important;
  }
  .product__title-highlight {
    display: block !important;
    font-size: 42px !important;
    font-weight: 900 !important;
    color: #000000 !important;
    line-height: 1.1 !important;
    letter-spacing: -0.03em !important;
    white-space: nowrap !important;
  }
  @media (max-width: 768px) {
    .product__title,
    .product-page__title,
    h1.product__title {
      white-space: normal !important;
      line-height: 1.14 !important;
      margin-bottom: 12px !important;
      overflow: visible !important;
      text-overflow: unset !important;
    }
    .product__title-prefix {
      font-size: clamp(23px, 6.6vw, 28px) !important;
      font-weight: 700 !important;
      color: #374151 !important;
      margin-bottom: 3px !important;
      display: block !important;
      white-space: nowrap !important;
      letter-spacing: -0.02em !important;
      line-height: 1.15 !important;
    }
    .product__title-highlight {
      font-size: clamp(26px, 7.5vw, 34px) !important;
      font-weight: 900 !important;
      color: #000000 !important;
      line-height: 1.12 !important;
      letter-spacing: -0.035em !important;
      display: block !important;
      white-space: nowrap !important;
    }
  }
  {%- if product.handle == '5-courses-interior-exterior-design-ai' -%}
  .product__title-highlight {
    font-size: 38px !important;
    white-space: normal !important;
  }
  @media (max-width: 768px) {
    .product__title-highlight {
      font-size: clamp(20px, 6.2vw, 28px) !important;
      white-space: normal !important;
      word-break: break-word !important;
      line-height: 1.18 !important;
    }
  }
  .product-devices-compatibility {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin: 8px 0 10px 0;
    font-size: 13px;
    line-height: 1;
  }
  .pd-comp-pill {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: #f4f4f5;
    border: 1px solid #e4e4e7;
    padding: 5px 11px;
    border-radius: 9999px;
  }
  .pd-comp-text {
    color: #4b5563;
    font-weight: 600;
    font-size: 12.5px;
  }
  .pd-device-name {
    color: #18181b;
    font-weight: 700;
    font-size: 12.5px;
    letter-spacing: -0.01em;
  }
  .pd-comp-amp {
    color: #a1a1aa;
    font-weight: 500;
    font-size: 12px;
  }
  .pd-win-icon {
    width: 14px;
    height: 14px;
    vertical-align: middle;
  }
  .pd-mac-icon {
    width: 13px;
    height: 13px;
    color: #09090b;
    vertical-align: middle;
  }
  @media (max-width: 480px) {
    .product-devices-compatibility {
      margin: 6px 0 8px 0;
      gap: 5px;
    }
    .pd-comp-pill {
      padding: 4px 9px;
      gap: 5px;
    }
    .pd-comp-text, .pd-device-name {
      font-size: 11.5px;
    }
  }
  {%- endif -%}
</style>