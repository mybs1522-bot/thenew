<script>
/* Direct 1-Click Buy Now to Checkout */
window.executeDirectBuyNow = function(e, btn) {
  if (e) {
    e.preventDefault();
    e.stopPropagation();
  }
  if (!btn) btn = (e && e.currentTarget) ? e.currentTarget : document.querySelector('[data-buy-button]');
  if (btn) {
    btn.style.opacity = '0.85';
    btn.style.pointerEvents = 'none';
    const textSpan = btn.querySelector('[data-button-text]');
    if (textSpan) textSpan.textContent = 'Redirecting to Checkout...';
  }

  let variantId = null;
  let qty = 1;

  const form = btn ? btn.closest('form') : document.querySelector('form[action*="/cart/add"]');
  if (form) {
    const varInp = form.querySelector('[name="id"]');
    if (varInp && varInp.value) variantId = varInp.value;
    const qtyInp = form.querySelector('[name="quantity"]');
    if (qtyInp && qtyInp.value) qty = parseInt(qtyInp.value, 10) || 1;
  }
  if (!variantId) {
    const varInp = document.querySelector('[data-bstr-variant-input]') || document.querySelector('input[name="id"]');
    if (varInp && varInp.value) variantId = varInp.value;
  }
  if (!variantId) {
    variantId = '{{ product.selected_or_first_available_variant.id }}';
  }

  fetch('/cart/add.js', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: variantId, quantity: qty })
  })
  .then(function() {
    window.location.href = '/checkout';
  })
  .catch(function(err) {
    console.error('Checkout redirect fallback:', err);
    window.location.href = '/checkout';
  });
};

/* Instant init for ATC Transparent Pill Urgency Timer */
(function() {
  const DURATION_SECONDS = 7 * 3600 + 37 * 60 + 40;
  const STORAGE_KEY = 'arch_evergreen_deadline_v1';

  function initPillTimer() {
    let stored = localStorage.getItem(STORAGE_KEY);
    const now = Date.now();
    let deadline;
    if (!stored || isNaN(parseInt(stored, 10)) || parseInt(stored, 10) <= now) {
      deadline = now + DURATION_SECONDS * 1000;
      localStorage.setItem(STORAGE_KEY, deadline);
    } else {
      deadline = parseInt(stored, 10);
    }

    const diff = Math.max(0, Math.floor((deadline - now) / 1000));
    const h = Math.floor(diff / 3600);
    const m = Math.floor((diff % 3600) / 60);
    const s = diff % 60;
    const pad = n => (n < 10 ? '0' + n : '' + n);

    const elH = document.getElementById('atcPillHours');
    const elM = document.getElementById('atcPillMinutes');
    const elS = document.getElementById('atcPillSeconds');
    if (elH) elH.textContent = pad(h);
    if (elM) elM.textContent = pad(m);
    if (elS) elS.textContent = pad(s);
  }

  function syncPillPrice() {
    const pillCut = document.querySelector('.arch-pill-price-cut');
    const pillActive = document.querySelector('.arch-pill-price-active');
    const mainPriceEl = document.querySelector('[data-product-price]');
    
    if (pillCut && pillCut.textContent.includes('Rs')) {
      pillCut.textContent = pillCut.textContent.replace(/Rs\.?\s*/g, '₹');
    }
    if (pillActive && pillActive.textContent.includes('Rs')) {
      pillActive.textContent = pillActive.textContent.replace(/Rs\.?\s*/g, '₹');
    }

    let source = (pillActive && pillActive.textContent.trim()) ? pillActive.textContent.trim() : (mainPriceEl ? mainPriceEl.textContent.trim() : '');
    if (!source || !pillCut) return;

    source = source.replace(/Rs\.?\s*/g, '₹');
    const match = source.match(/[\d,.]+/);
    if (!match) return;

    const rawNumStr = match[0].replace(/,/g, '');
    const num = parseFloat(rawNumStr);
    if (isNaN(num) || num <= 0) return;

    const doubled = num * 2;
    const formattedNum = (doubled % 1 === 0) ? Math.round(doubled).toString() : doubled.toFixed(2);
    pillCut.textContent = source.replace(match[0], formattedNum);
  }

  function checkCurrencyAndToggleDynamicButton() {
    var isDollar = true;
    
    if (window.Shopify && window.Shopify.currency && window.Shopify.currency.active) {
      var activeCur = (window.Shopify.currency.active || '').toUpperCase();
      var dollarCurrencies = ['USD', 'CAD', 'AUD', 'NZD', 'SGD', 'HKD'];
      isDollar = dollarCurrencies.indexOf(activeCur) !== -1;
    } else {
      var priceEl = document.querySelector('[data-product-price], .product__price, .arch-pill-price-active');
      if (priceEl) {
        var txt = (priceEl.textContent || '').trim();
        if (txt.includes('₹') || txt.includes('Rs') || txt.includes('€') || txt.includes('£') || txt.includes('AED') || txt.includes('¥')) {
          isDollar = false;
        } else if (txt.includes('$') || txt.includes('USD')) {
          isDollar = true;
        }
      }
    }

    var dynamicBtns = document.querySelectorAll('.checkout--dynamic, [data-dynamic-button], .product__shoppay-installments');
    if (isDollar) {
      document.body.classList.remove('non-dollar-currency');
      dynamicBtns.forEach(function(el) {
        el.classList.remove('hide-non-dollar-btn');
        if (el.style.display === 'none') el.style.display = '';
      });
    } else {
      document.body.classList.add('non-dollar-currency');
      dynamicBtns.forEach(function(el) {
        el.classList.add('hide-non-dollar-btn');
        el.style.display = 'none';
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      initPillTimer();
      syncPillPrice();
      checkCurrencyAndToggleDynamicButton();
    });
  } else {
    initPillTimer();
    syncPillPrice();
    checkCurrencyAndToggleDynamicButton();
  }
  setInterval(initPillTimer, 1000);

  document.addEventListener('booster:currency:changed', function() {
    syncPillPrice();
    checkCurrencyAndToggleDynamicButton();
  });
  document.addEventListener('booster:content:update', function() {
    syncPillPrice();
    checkCurrencyAndToggleDynamicButton();
  });
  document.addEventListener('change', function(e) {
    if (e.target && (e.target.matches('[data-swatch-index]') || e.target.name === 'id' || e.target.matches('[data-currency-selector]'))) {
      setTimeout(function() {
        syncPillPrice();
        checkCurrencyAndToggleDynamicButton();
      }, 100);
    }
  });

  var currencyCheckAttempts = 0;
  var currencyCheckTimer = setInterval(function() {
    checkCurrencyAndToggleDynamicButton();
    currencyCheckAttempts++;
    if (currencyCheckAttempts > 25) clearInterval(currencyCheckTimer);
  }, 200);
})();
</script>